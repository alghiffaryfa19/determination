#!/system/bin/sh
# Bounded guacamoleb direct-ALSA playback gate. Always restores Android owners.
set -eu

AURORA=${AURORA_ROOT:-/data/aurora}
HOST_TONE=${1:-$AURORA/guest/home/aurora/aurora-audio-tone.wav}
GUEST_TONE=${2:-/home/aurora/aurora-audio-tone.wav}
MODE=${3:-alsa}
ROUTE='QUAT_MI2S_RX Audio Mixer MultiMedia1'
SELECTOR='TFA_CHIP_SELECTOR'
LXC="$AURORA/lxc/bin/lxc-attach -P $AURORA -n guest --"
STATE="$AURORA/state"
OWNER="$AURORA/bin/aurora-audio-owner"
PROBE="$AURORA/bin/aurora-audio-probe"
claimed=0

original_selector=$(tinymix "$SELECTOR" 2>/dev/null | awk '{print $2}')
case "$original_selector" in ''|*[!0-9]*) original_selector=3;; esac
route_state=$(tinymix "$ROUTE" 2>/dev/null)
case "$route_state" in
    *'On On')   original_route_left=1; original_route_right=1;;
    *'On Off')  original_route_left=1; original_route_right=0;;
    *'Off On')  original_route_left=0; original_route_right=1;;
    *'Off Off') original_route_left=0; original_route_right=0;;
    *) echo "cannot parse route state: $route_state" >&2; exit 2;;
esac

restore_audio() {
    trap - EXIT INT TERM
    tinymix "$ROUTE" "$original_route_left" >/dev/null 2>&1 || true
    tinymix "$SELECTOR" "$original_selector" >/dev/null 2>&1 || true
    if [ "$claimed" = 1 ]; then
        "$OWNER" restore --apply || true
    fi
    tinymix > "$STATE/audio-mixer-after.txt" 2>&1 || true
}
trap restore_audio EXIT INT TERM

mkdir -p "$STATE"
[ -f "$HOST_TONE" ] || { echo "missing test tone: $HOST_TONE" >&2; exit 2; }
[ -x "$OWNER" ] && [ -x "$PROBE" ] || {
    echo "direct-audio owner/probe is not installed" >&2
    exit 2
}
tinymix > "$STATE/audio-mixer-before.txt"

"$OWNER" claim --apply
claimed=1
"$PROBE" --require-unowned >/dev/null
[ -f "$AURORA/run/control/audio-claimed" ] || {
    echo "owner did not publish audio-claimed" >&2
    exit 1
}

# PCM 0 is MultiMedia1. The OnePlus 7 speaker backend is QUAT_MI2S_RX and the
# TFA selector value 2 is the vendor speaker route. Test amplitude is encoded
# in the supplied WAV; the repository gate uses a one-second -40 dBFS tone.
tinymix "$ROUTE" 1
tinymix "$SELECTOR" 2
case "$MODE" in
    alsa)
        $LXC /usr/bin/env HOME=/root TMPDIR=/tmp \
            /usr/bin/aplay -q -D hw:0,0 "$GUEST_TONE"
        ;;
    pipewire-inspect)
        $LXC /usr/local/bin/aurora-pipewire-smoke inspect "$GUEST_TONE"
        ;;
    pipewire-play)
        $LXC /usr/local/bin/aurora-pipewire-smoke play "$GUEST_TONE"
        ;;
    *) echo "unknown playback mode: $MODE" >&2; exit 2;;
esac

restore_audio
claimed=0
trap - EXIT INT TERM

[ "$(getprop init.svc.audioserver)" = running ] || {
    echo "audioserver did not restore" >&2
    exit 1
}
[ "$(getprop init.svc.vendor.audio-hal)" = running ] || {
    echo "vendor.audio-hal did not restore" >&2
    exit 1
}
echo "direct ALSA tone complete; Android audio restored"
