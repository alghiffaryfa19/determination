#!/bin/sh
# Determination: the ARM guest runs Hyprland directly with no uwsm session, so
# uwsm-app has nothing to wrap. Launch apps straight through; callers pass
# `-- cmd...` exactly as they would to uwsm-app.
set -u

[ "$#" -gt 0 ] || exit 2
[ "$1" = -- ] && shift
[ "$#" -gt 0 ] || exit 2
exec "$@"
