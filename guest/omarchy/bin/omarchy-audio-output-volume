#!/bin/sh
set -u

percent=${1:-}
case "$percent" in
    ''|*[!0-9]*) exit 0 ;;
esac
[ "$percent" -le 150 ] 2>/dev/null || exit 0

if command -v wpctl >/dev/null 2>&1; then
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${percent}%" >/dev/null 2>&1 || true
elif command -v pactl >/dev/null 2>&1; then
    pactl set-sink-volume @DEFAULT_SINK@ "${percent}%" >/dev/null 2>&1 || true
fi
