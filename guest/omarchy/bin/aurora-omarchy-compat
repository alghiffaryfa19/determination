#!/bin/sh
set -u

command_name=$(basename "$0")
root=/usr/local/share/aurora-omarchy
[ -z "${AURORA_OMARCHY_PATH:-}" ] || root=$AURORA_OMARCHY_PATH

install_links() {
    target=$1
    [ -d "$target" ] || exit 0
    while IFS= read -r name; do
        case "$name" in
            omarchy|omarchy-*)
                [ ! -e "$target/$name" ] && [ ! -L "$target/$name" ] || continue
                ln -s "$root/bin/aurora-omarchy-compat" "$target/$name"
                ;;
        esac
    done < "$root/bin/compat-commands"
}

case "$command_name" in
    aurora-omarchy-compat)
        [ "${1:-}" = --install-links ] && [ "$#" -eq 2 ] || exit 2
        install_links "$2"
        exit 0
        ;;
    omarchy)
        [ "$#" -gt 0 ] || exit 0
        group=$1
        shift
        case "$group" in
            shell) exec omarchy-shell "$@" ;;
            system)
                [ "$#" -gt 0 ] || exit 0
                action=$1
                shift
                case "$action" in
                    logout|reboot|shutdown|lock) exec "omarchy-system-$action" "$@" ;;
                    suspend|hibernate) echo "Android owns suspend in this session" >&2; exit 69 ;;
                esac
                ;;
            audio)
                [ "$#" -gt 1 ] || exit 0
                area=$1
                action=$2
                shift 2
                case "$area:$action" in
                    output:set) exec omarchy-audio-output-set-default "$@" ;;
                    input:set) exec omarchy-audio-input-set-default "$@" ;;
                    output:sink) exec omarchy-audio-output-sink "$@" ;;
                esac
                ;;
        esac
        exit 0
        ;;
    omarchy-system-logout)
        [ -w /mnt/aurora-control ] && : > /mnt/aurora-control/exit
        exit 0
        ;;
    omarchy-system-reboot|omarchy-system-shutdown|omarchy-system-factory-reset)
        echo "$command_name: Android power control is unavailable from this session" >&2
        exit 69
        ;;
    omarchy-update)
        echo "$command_name: full-system update is not supported in this session; use the Update submenus for shell, config and hardware restarts" >&2
        exit 69
        ;;
    omarchy-brightness-display|omarchy-brightness-display-apple|omarchy-brightness-display-ddc)
        echo "$command_name: Android owns panel brightness in this session" >&2
        exit 69
        ;;
    omarchy-cmd-present)
        for candidate in "$@"; do command -v "$candidate" >/dev/null 2>&1 || exit 1; done
        exit 0
        ;;
    omarchy-cmd-missing)
        for candidate in "$@"; do command -v "$candidate" >/dev/null 2>&1 && exit 1; done
        exit 0
        ;;
    omarchy-pkg-present|omarchy-pkg-missing)
        [ "$#" -gt 0 ] || exit 2
        present=0
        for package in "$@"; do
            case "$package" in ''|-*|*[!A-Za-z0-9+_.@:-]*) exit 2 ;; esac
            if command -v pacman >/dev/null 2>&1; then
                pacman -Q "$package" >/dev/null 2>&1 || present=1
            elif command -v dpkg-query >/dev/null 2>&1; then
                dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed || present=1
            else
                exit 69
            fi
        done
        if [ "$command_name" = omarchy-pkg-missing ]; then [ "$present" -ne 0 ]; else [ "$present" -eq 0 ]; fi
        exit $?
        ;;
    omarchy-launch-browser|omarchy-launch-webapp)
        exec xdg-open "${1:-https://omarchy.org}"
        ;;
    omarchy-launch-terminal)
        guest_shell=$(awk -F: -v uid="$(id -u)" '$3 == uid { print $7; exit }' /etc/passwd 2>/dev/null || true)
        [ -n "$guest_shell" ] && [ -x "$guest_shell" ] || guest_shell=/bin/sh
        export SHELL="$guest_shell"
        command -v aurora-osk >/dev/null 2>&1 && aurora-osk show >/dev/null 2>&1 || true
        exec foot "$@"
        ;;
    omarchy-launch-file-manager)
        exec xdg-open "${1:-$HOME}"
        ;;
    omarchy-restart-shell)
        exec aurora-omarchy reload
        ;;
    omarchy-launch-about)
        exec foot /bin/sh -c 'cat /etc/os-release; printf "\nOmarchy on Aurora: vendor EGL through libhybris\n"; printf "Press Enter to close"; read -r answer'
        ;;
    omarchy-hw-touchscreen)
        exit 0
        ;;
    omarchy-hw-*|omarchy-hibernation-available)
        exit 1
        ;;
    omarchy-network-status)
        ip route get 1.1.1.1 >/dev/null 2>&1 && printf '%s\n' wifi
        exit 0
        ;;
    *)
        echo "$command_name: not implemented for Aurora" >&2
        exit 69
        ;;
esac
