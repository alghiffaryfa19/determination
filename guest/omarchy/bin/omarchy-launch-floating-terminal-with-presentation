#!/bin/sh
# Determination: launch a floating terminal with the Omarchy presentation
# wrapper (logo first, Done prompt after, unless aborted with ^C).
#
# The ARM guest runs Hyprland directly with no uwsm session wrapper and no
# xdg-terminal-exec, so upstream's launcher cannot run here. The app-id matches
# upstream's org.omarchy.terminal, which hyprland-omarchy.conf floats.
set -u

[ "$#" -gt 0 ] || exit 0
cmd="$*"
run="omarchy-show-logo 2>/dev/null; $cmd; status=\$?; if [ \$status -ne 130 ]; then omarchy-show-done 2>/dev/null; fi"

if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch "hl.dsp.exec_cmd([[foot --app-id=org.omarchy.terminal --title=Omarchy /bin/sh -c \"$run\"]])" >/dev/null 2>&1 || \
        hyprctl dispatch exec -- foot --app-id=org.omarchy.terminal --title=Omarchy /bin/sh -c "$run" >/dev/null 2>&1 || \
        exec setsid foot --app-id=org.omarchy.terminal --title=Omarchy /bin/sh -c "$run"
    exit 0
fi
exec setsid foot --app-id=org.omarchy.terminal --title=Omarchy /bin/sh -c "$run"
