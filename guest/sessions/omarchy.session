id=omarchy
title=Omarchy
description=Omarchy Quickshell on Hyprland with vendor EGL/GLES through libhybris, command-backed audio/MPRIS controls, and a corrected phone battery gauge.
backend=libhybris-hwcomposer
renderer=vendor-hybris
allocator=android-gralloc
presentation=multi-output-direct
input=evdev-grab
compositor=/usr/local/bin/aurora-hyprland-omarchy
shell=/usr/local/bin/aurora-omarchy
required_binaries=/opt/hyprland/bin/Hyprland,/opt/hyprland/bin/quickshell,/opt/hyprland/bin/hyprctl,/opt/hyprland/bin/hyprland-dialog,/opt/hyprland/lib/libhyprgrass.so,/usr/local/bin/aurora-omarchy
packages=hyprland,quickshell
build=/root/aurora-build/build-hyprland.sh
glue=aurora-hyprland-omarchy,aurora-omarchy
qualification=experimental
reason=Omarchy is wired for Aurora's vendor-EGL Hyprland path; first-device shell rendering and repeated Android restore remain unqualified.
limitations=Arch and uwsm operations are compatibility-adapted,Privileged power RPC is not implemented,Generic DMA-BUF and screencopy remain unsupported
