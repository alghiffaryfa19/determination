id=weston
title=Weston (nested)
description=Reference Wayland compositor running nested inside the active session. Useful to separate compositor bugs from backend bugs.
backend=nested-wayland
renderer=vendor-hybris
allocator=android-gralloc
presentation=windowed
input=none
compositor=/usr/bin/weston
requires=display.internal.hwc,renderer.vendor-hybris
qualification=diagnostic
