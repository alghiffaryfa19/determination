id=phosh
title=Phosh
description=The verified stack: phoc 0.47 on the droidian wlroots hwcomposer backend, phosh mobile shell, squeekboard OSK. This is what desktop mode runs.
backend=libhybris-hwcomposer
renderer=vendor-hybris
allocator=android-gralloc
presentation=internal-direct
input=evdev-grab
compositor=/usr/local/bin/phoc|/usr/bin/phoc
shell=/usr/libexec/phosh|/usr/bin/phosh
required_binaries=/usr/libexec/phosh|/usr/bin/phosh,/usr/bin/squeekboard
packages=phosh
build=/root/aurora-build/build-wlroots-phoc.sh
glue=aurora-phosh-session
services=seatd,pipewire,wireplumber
requires=display.internal.hwc,renderer.vendor-hybris,input.touch.internal
limitations=phoc teardown can segfault on exit (cosmetic),matrix flat varyings in GSK shaders unverified
qualification=qualified
