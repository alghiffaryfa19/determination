#!/bin/sh
set -eu
case "${1:-toggle}" in
    show) visible=true ;;
    hide) visible=false ;;
    toggle)
        state=$(gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
            --method org.freedesktop.DBus.Properties.Get sm.puri.OSK0 Visible)
        case "$state" in
            *true*) visible=false ;;
            *false*) visible=true ;;
            *) echo "det-osk: unexpected visibility reply: $state" >&2; exit 1 ;;
        esac
        ;;
    *) echo 'usage: det-osk [toggle|show|hide]' >&2; exit 2 ;;
esac
exec gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
    --method sm.puri.OSK0.SetVisible "$visible"
