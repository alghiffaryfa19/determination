#!/usr/bin/env python3
"""Seed Determination's web-content zoom without overriding user choices."""

import glob
import os
import sqlite3
import time

SETTING = "browser.content.full-zoom"
DEFAULT_ZOOM = 0.67


def apply(database: str) -> None:
    connection = sqlite3.connect(database, timeout=5)
    try:
        setting = connection.execute(
            "SELECT id FROM settings WHERE name = ?", (SETTING,)
        ).fetchone()
        if setting is None:
            connection.execute("INSERT INTO settings(name) VALUES (?)", (SETTING,))
            setting_id = connection.execute(
                "SELECT id FROM settings WHERE name = ?", (SETTING,)
            ).fetchone()[0]
        else:
            setting_id = setting[0]

        current = connection.execute(
            "SELECT value FROM prefs WHERE groupID IS NULL AND settingID = ?",
            (setting_id,),
        ).fetchone()
        if current is not None:
            print(f"Firefox default content zoom preserved at {float(current[0]) * 100:g}%")
            return

        connection.execute(
            "INSERT INTO prefs(groupID, settingID, value, timestamp) "
            "VALUES (NULL, ?, ?, ?)",
            (setting_id, DEFAULT_ZOOM, int(time.time() * 1000)),
        )
        connection.commit()
        print(f"Firefox default content zoom -> 67% ({database})")
    finally:
        connection.close()


home = os.environ.get("HOME", "/home/detuser")
for profile_database in glob.glob(
    os.path.join(home, ".mozilla/firefox/*/content-prefs.sqlite")
):
    apply(profile_database)
