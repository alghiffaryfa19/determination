#!/bin/sh
# Apply Aurora hardware-button mappings inside the active phosh D-Bus
# session. The companion app writes /etc/aurora/input-actions.conf.

set -eu

CONFIG=${AURORA_INPUT_ACTIONS_CONFIG:-/etc/aurora/input-actions.conf}
BASE=org.gnome.settings-daemon.plugins.media-keys
CUSTOM=$BASE.custom-keybinding
PREFIX=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/aurora-

binding_for() {
    case "$1" in
        KEY_VOLUMEUP) echo XF86AudioRaiseVolume ;;
        KEY_VOLUMEDOWN) echo XF86AudioLowerVolume ;;
        KEY_MUTE|KEY_MICMUTE) echo XF86AudioMute ;;
        KEY_MEDIA) echo XF86AudioMedia ;;
        KEY_PLAYPAUSE|KEY_PLAY) echo XF86AudioPlay ;;
        KEY_NEXTSONG) echo XF86AudioNext ;;
        KEY_PREVIOUSSONG) echo XF86AudioPrev ;;
        KEY_F3) echo F3 ;;
        KEY_F4) echo F4 ;;
        KEY_HOME) echo Home ;;
        KEY_CAMERA) echo XF86WebCam ;;
        KEY_SEARCH) echo XF86Search ;;
        *) return 1 ;;
    esac
}

command_for() {
    case "$1" in
        volume-up) echo "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 6%+" ;;
        volume-down) echo "wpctl set-volume @DEFAULT_AUDIO_SINK@ 6%-" ;;
        mute) echo "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" ;;
        play-pause) echo "aurora-media-action play-pause" ;;
        next) echo "aurora-media-action next" ;;
        previous) echo "aurora-media-action previous" ;;
        exit-desktop) echo "touch /mnt/aurora-control/exit" ;;
        *) return 1 ;;
    esac
}

reset_native() {
    # Restore the built-in media bindings before selectively replacing one.
    for key in volume-up-static volume-down-static volume-mute-static \
               media-static play-static next-static previous-static; do
        gsettings reset "$BASE" "$key" 2>/dev/null || true
    done
}

apply_mappings() {
    reset_native
    paths=
    index=0
    [ -r "$CONFIG" ] || {
        gsettings set "$BASE" custom-keybindings "[]"
        return 0
    }

    while IFS='=' read -r trigger action; do
        case "$trigger" in ''|'#'*) continue ;; esac
        [ "$action" != default ] || continue
        binding=$(binding_for "$trigger" 2>/dev/null || true)
        command=$(command_for "$action" 2>/dev/null || true)
        [ -n "$binding" ] && [ -n "$command" ] || continue

        # A remapped media key must not also execute its stock action.
        case "$trigger" in
            KEY_VOLUMEUP) gsettings set "$BASE" volume-up-static "[]" ;;
            KEY_VOLUMEDOWN) gsettings set "$BASE" volume-down-static "[]" ;;
            KEY_MUTE|KEY_MICMUTE) gsettings set "$BASE" volume-mute-static "[]" ;;
            KEY_MEDIA) gsettings set "$BASE" media-static "[]" ;;
            KEY_PLAYPAUSE|KEY_PLAY) gsettings set "$BASE" play-static "[]" ;;
            KEY_NEXTSONG) gsettings set "$BASE" next-static "[]" ;;
            KEY_PREVIOUSSONG) gsettings set "$BASE" previous-static "[]" ;;
        esac

        index=$((index + 1))
        path="${PREFIX}${index}/"
        gsettings set "$CUSTOM:$path" name "Aurora: $trigger -> $action"
        gsettings set "$CUSTOM:$path" binding "$binding"
        gsettings set "$CUSTOM:$path" command "$command"
        paths="${paths}'${path}', "
    done < "$CONFIG"

    paths=${paths%, }
    gsettings set "$BASE" custom-keybindings "[${paths}]"
}

case "${1:-apply}" in
    apply) apply_mappings ;;
    reset)
        reset_native
        gsettings set "$BASE" custom-keybindings "[]"
        ;;
    show)
        [ -r "$CONFIG" ] && cat "$CONFIG" || true
        ;;
    *) echo "usage: aurora-input-actions [apply|reset|show]" >&2; exit 2 ;;
esac
