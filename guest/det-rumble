#!/usr/bin/env python3
"""det-rumble - one-shot vibration smoke test through the qti-haptics
evdev force-feedback device. Uploads an FF_RUMBLE effect and plays it.
Exit 0 + "buzzed" means the motor path works for feedbackd/sliderd."""

import fcntl
import os
import struct
import sys


def find_node():
    name_seen = False
    for line in open("/proc/bus/input/devices"):
        if line.startswith("N:"):
            name_seen = "qti-haptics" in line
        elif name_seen and line.startswith("H:"):
            # A device whose ONLY handler is its event node renders as
            # "H: Handlers=event5" - strip the prefix before matching.
            for tok in line.split():
                tok = tok.replace("Handlers=", "")
                if tok.startswith("event"):
                    return "/dev/input/" + tok.rstrip()
    return None


node = find_node()
if not node:
    print("no qti-haptics input device found", file=sys.stderr)
    sys.exit(1)

try:
    fd = os.open(node, os.O_RDWR)
except PermissionError:
    print(f"cannot write {node} (need root or android_input+write)",
          file=sys.stderr)
    sys.exit(1)

# EVIOCSFF = _IOW('E',0x80,struct ff_effect); kernel dispatches on the NR
# byte alone. Buffer must be >= kernel sizeof(ff_effect) or copy_from_user
# EFAULTs; escalate sizes since trees pack the condition[2] union variously.
EV_FF = 0x15
FF_RUMBLE = 0x50


def buzz_uploaded(fd):
    eff = bytearray(struct.pack(
        "<HHHHHHHHH",
        0x50, 0xFFFF, 0, 0, 0, 250, 0, 0xC000, 0x4000,
    ) + b"\x00" * 46)
    fcntl.ioctl(fd, EVIOCSFF, eff)
    effect_id = struct.unpack_from("<h", eff, 2)[0]
    os.write(fd, struct.pack("<qqHHi", 0, 0, EV_FF, effect_id & 0xFFFF, 1))
    return "uploaded effect %d" % effect_id


def buzz_memless(fd):
    # ff-memless devices skip upload: playing FF_RUMBLE directly drives the
    # driver's default rumble.
    os.write(fd, struct.pack("<qqHHi", 0, 0, EV_FF, FF_RUMBLE, 1))
    return "played raw FF_RUMBLE"


for attempt in (buzz_memless, buzz_uploaded):
    try:
        print(attempt(fd), "-", node)
        break
    except OSError as e:
        print(f"{attempt.__name__}: {e}", file=sys.stderr)
else:
    sys.exit(1)
