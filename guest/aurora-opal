#!/bin/sh
# Aurora adapter for the vendored Opal Quickshell configuration.
set -eu

CONFIG=/usr/local/share/aurora-opal
RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
QUICKSHELL=${AURORA_OPAL_QUICKSHELL:-/opt/aurorahyprland/bin/quickshell}
export XDG_RUNTIME_DIR="$RUNTIME"
# The compositor's null platform must not leak into Wayland clients.
export EGL_PLATFORM=wayland
export HYBRIS_EGLPLATFORM=wayland
export QT_QPA_PLATFORM=wayland
export AURORA_OPAL_GLES=1
export QSG_RHI_BACKEND=opengl
export QSG_RENDER_LOOP=basic
export GDK_BACKEND=${GDK_BACKEND:-wayland}

shell() {
    if [ ! -x "$QUICKSHELL" ]; then
        QUICKSHELL=$(command -v quickshell 2>/dev/null || true)
    fi
    [ -n "${QUICKSHELL:-}" ] && [ -x "$QUICKSHELL" ] || {
        echo "aurora-opal: quickshell is not installed" >&2
        exit 127
    }
}

stop_shells() {
    for proc in /proc/[0-9]*; do
        pid=${proc##*/}
        [ -r "$proc/cmdline" ] || continue
        command=$(tr '\000' '\n' < "$proc/cmdline")
        [ "$(printf '%s\n' "$command" | sed -n '1p')" = "$QUICKSHELL" ] || continue
        printf '%s\n' "$command" | grep -Fqx "$CONFIG" || continue
        kill -TERM "$pid" 2>/dev/null || continue
        attempt=0
        while kill -0 "$pid" 2>/dev/null && [ "$attempt" -lt 20 ]; do
            sleep 0.1
            attempt=$((attempt + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    done
}

case "${1:-start}" in
    start)
        shell
        test -r "$CONFIG/shell.qml" || { echo "aurora-opal: missing $CONFIG" >&2; exit 2; }
        stop_shells
        exec "$QUICKSHELL" -d -n -p "$CONFIG"
        ;;
    stop)
        shell
        stop_shells
        ;;
    reload)
        shell
        exec "$0" start
        ;;
    launcher|controls|audio|notifications|clipboard|phone|gaming|desktop|adaptive|appearance|convergence|close|inspect)
        shell
        exec "$QUICKSHELL" ipc -p "$CONFIG" call opal "$1"
        ;;
    check)
        shell
        test -r "$CONFIG/shell.qml"
        echo "aurora-opal: ready"
        ;;
    *)
        echo "usage: aurora-opal [start|stop|reload|launcher|controls|audio|notifications|clipboard|phone|gaming|desktop|adaptive|appearance|convergence|close|inspect|check]" >&2
        exit 2
        ;;
esac
