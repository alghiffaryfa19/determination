## Determination patch for LXC 4.0.12. It modifies src/lxc/attach.c, which
## upstream marks LGPL-2.1-or-later; retain the upstream LXC notices.

--- a/src/lxc/attach.c
+++ b/src/lxc/attach.c
@@ -1063,19 +1063,13 @@
 	}
 
         /* Remove current setting. */
-	if (!c->set_config_item(c, "lxc.seccomp.profile", "") &&
-	    !c->set_config_item(c, "lxc.seccomp", ""))
+	if (!c->set_config_item(c, "lxc.seccomp.profile", ""))
 		return false;
 
