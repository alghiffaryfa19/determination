#!/bin/sh
# Full Plasma Desktop on KWin's virtual-EGL gralloc-pool output. KWin loads
# Mesa only; libhybris and Android native handles stay in det-gralloc-pool.
set -eu

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/home/melissa USER=melissa LOGNAME=melissa
export LANG=C.UTF-8 TMPDIR=/tmp
export XDG_RUNTIME_DIR=/tmp/det-plasma-presenter-1000
export XDG_CONFIG_HOME=$XDG_RUNTIME_DIR/config
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE
export WAYLAND_DISPLAY=wayland-presenter
export KWIN_COMPOSE=O2ES
export QSG_RHI_BACKEND=opengl
export LD_PRELOAD=/usr/local/lib/det-pidfd-shim.so
export DETERMINATION_GRALLOC_POOL=/run/determination/gralloc-pool.sock

[ -r /etc/determination-device.conf ] && . /etc/determination-device.conf
. /usr/local/lib/determination/det-graphics-renderer-env

WIDTH=${DET_PLASMA_WIDTH:-1920}
HEIGHT=${DET_PLASMA_HEIGHT:-1080}
case "$WIDTH" in ''|*[!0-9]*) echo "invalid width: $WIDTH" >&2; exit 2;; esac
case "$HEIGHT" in ''|*[!0-9]*) echo "invalid height: $HEIGHT" >&2; exit 2;; esac

install -d -m 0700 "$XDG_RUNTIME_DIR"
install -d -m 0700 "$XDG_CONFIG_HOME"
rm -f "$XDG_RUNTIME_DIR/wayland-presenter" \
    "$XDG_RUNTIME_DIR/wayland-presenter.lock"

# Package KWin plugins were built against the distro KWin ABI.  The presenter
# uses a purpose-built, X11-free KWin, so loading those plugins is unsafe.
# Built-in effects remain available from the matching executable.
printf '%s\n' \
    '[Plugins]' \
    'nightlightEnabled=false' \
    'screencastEnabled=false' \
    'eisEnabled=false' \
    'krunnerintegrationEnabled=false' \
    'keynotificationEnabled=false' \
    'stickykeysEnabled=false' \
    'bouncekeysEnabled=false' \
    'buttonrebindsEnabled=false' \
    'buttonsrebindEnabled=false' \
    'mousekeysEnabled=false' \
    > "$XDG_CONFIG_HOME/kwinrc"

exec dbus-run-session -- /bin/sh -c '
    echo "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/det-plasma-presenter-bus"
    exec kwin_wayland --virtual --width "$1" --height "$2" --scale 1 \
        --socket wayland-presenter \
        /usr/local/bin/det-plasma-desktop-client
' _ "$WIDTH" "$HEIGHT"
