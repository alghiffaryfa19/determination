#!/bin/sh
set -eu

get_visible() {
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
            --method org.freedesktop.DBus.Properties.Get sm.puri.OSK0 Visible
    elif command -v busctl >/dev/null 2>&1; then
        busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible
    else
        echo 'aurora-osk: neither gdbus nor busctl is available' >&2
        return 127
    fi
}

set_visible() {
    visible=$1
    if command -v gdbus >/dev/null 2>&1; then
        exec gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
            --method sm.puri.OSK0.SetVisible "$visible"
    elif command -v busctl >/dev/null 2>&1; then
        exec busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b "$visible"
    fi
    echo 'aurora-osk: neither gdbus nor busctl is available' >&2
    exit 127
}

case "${1:-toggle}" in
    show) visible=true ;;
    hide) visible=false ;;
    toggle)
        state=$(get_visible)
        case "$state" in
            *true*) visible=false ;;
            *false*) visible=true ;;
            *) echo "aurora-osk: unexpected visibility reply: $state" >&2; exit 1 ;;
        esac
        ;;
    *) echo 'usage: aurora-osk [toggle|show|hide]' >&2; exit 2 ;;
esac
set_visible "$visible"
