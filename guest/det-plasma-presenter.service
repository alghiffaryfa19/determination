[Unit]
Description=Determination full Plasma Desktop presenter session
Requires=det-gralloc-pool.service
After=dbus.service det-gralloc-pool.service

[Service]
Type=simple
User=melissa
Group=melissa
Environment=DET_PLASMA_WIDTH=1920
Environment=DET_PLASMA_HEIGHT=1080
ExecStart=/usr/local/bin/det-plasma-presenter-session
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
