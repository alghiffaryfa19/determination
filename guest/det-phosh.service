# A real PAM/logind session for the compatibility Phosh stack. This is started
# only during internal desktop mode; it is never enabled at boot.
[Unit]
Description=Determination Phosh application session
After=systemd-logind.service dbus.service
Wants=systemd-logind.service

[Service]
Type=simple
User=detuser
PAMName=login
TTYPath=/dev/tty1
UtmpIdentifier=tty1
StandardInput=null
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/detuser USER=detuser LOGNAME=detuser
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=phosh
Environment=XDG_CURRENT_DESKTOP=Phosh:GNOME DESKTOP_SESSION=phosh
ExecStart=/usr/local/bin/det-phosh-session
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=8
