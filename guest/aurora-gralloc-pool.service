[Unit]
Description=Aurora Android gralloc pool broker
After=dbus.service

[Service]
Type=simple
RuntimeDirectory=aurora
RuntimeDirectoryMode=0755
Environment=AURORA_PLASMA_WIDTH=1920
Environment=AURORA_PLASMA_HEIGHT=1080
Environment=AURORA_GRALLOC_POOL_SIZE=3
ExecStart=/usr/local/bin/aurora-gralloc-pool-session
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
