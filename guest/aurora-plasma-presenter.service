[Unit]
Description=Aurora full Plasma Desktop presenter session
Requires=aurora-gralloc-pool.service
After=dbus.service aurora-gralloc-pool.service

[Service]
Type=simple
User=aurora
Group=aurora
Environment=AURORA_PLASMA_WIDTH=1920
Environment=AURORA_PLASMA_HEIGHT=1080
ExecStart=/usr/local/bin/aurora-plasma-presenter-session
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
