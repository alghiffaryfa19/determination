#!/bin/sh
# Determination: launched by det-plasma.service inside a PAM/logind session.
# Runs as detuser (uid 1000 == AID_SYSTEM) like the phosh session: kgsl/ion
# are uid-1000-owned and input comes through the android_input group.
# Mesa env = /opt/mesa (zink/Turnip GL) --- never /usr/local (hybris world).
# Stage selection via /run/det-plasma.env (written by toggle/desktop-on):
#   DET_PLASMA_CLIENT=foot         kwin smoke (default)
#   DET_PLASMA_CLIENT=plasmashell  full Plasma Mobile shell
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/home/detuser USER=detuser LOGNAME=detuser
export LANG=C.UTF-8 TMPDIR=/tmp
# pam_systemd sets XDG_RUNTIME_DIR; belt-and-braces for manual runs.
[ -n "${XDG_RUNTIME_DIR:-}" ] || export XDG_RUNTIME_DIR=/run/user/1000
install -d -m 700 "$XDG_RUNTIME_DIR"

[ -r /etc/determination-device.conf ] && . /etc/determination-device.conf
[ -r /run/det-plasma.env ] && . /run/det-plasma.env
DET_GRAPHICS_RENDERER=${DET_GRAPHICS_RENDERER:-libhybris}
if [ "$DET_GRAPHICS_RENDERER" != mesa ]; then
    echo "FATAL: det-plasma-session is the experimental Mesa/Zink launcher; renderer is $DET_GRAPHICS_RENDERER" >&2
    exit 2
fi

. /opt/mesa/env.sh
export QT_QPA_PLATFORM=wayland XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE
# Diagnostics (2026-07-14 run 1 failed GL init + touch with no evidence):
# mesa EGL reasons + KWin's GL-backend and libinput device-add logging.
export EGL_LOG_LEVEL=debug
export QT_LOGGING_RULES="kwin_*.debug=true"
# Desktop-GL context created but checkSupported failed silently (run 2);
# force a GLES context --- zink's GLES 3.2 passes all of KWin's checks.
export KWIN_COMPOSE=O2ES

CLIENT="${DET_PLASMA_CLIENT:-foot}"
# Plasma Mobile needs the full startplasmamobile env (PLASMA_DEFAULT_SHELL
# etc.) --- det-plasma-client wraps that; plain plasmashell insta-crashes with
# an invalid desktop corona.
[ "$CLIENT" = "plasmashell" ] && CLIENT=/usr/local/bin/det-plasma-client

rm -f "$XDG_RUNTIME_DIR"/wayland-0 "$XDG_RUNTIME_DIR"/wayland-0.lock
# Log lives in the runtime dir (world-unreadable /var/log breaks as detuser);
# bus address exported for mid-run busctl diagnostics.
if [ "$CLIENT" = /usr/local/bin/det-plasma-client ]; then
    exec dbus-run-session -- /bin/sh -c '
        echo "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/det-plasma-bus"
        export XDG_RUNTIME_DIR
        exec kwin_wayland "$1"
    ' _ "$CLIENT" > "$XDG_RUNTIME_DIR/kwin.log" 2>&1
else
    exec dbus-run-session -- /bin/sh -c '
        echo "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/det-plasma-bus"
        export XDG_RUNTIME_DIR
        exec kwin_wayland --exit-with-session "$1"
    ' _ "$CLIENT" > "$XDG_RUNTIME_DIR/kwin.log" 2>&1
fi
