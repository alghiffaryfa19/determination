#!/bin/sh
set -eu

export OMARCHY_PATH=${AURORA_OMARCHY_PATH:-/usr/local/share/aurora-omarchy}
QUICKSHELL=${AURORA_OMARCHY_QUICKSHELL:-/opt/aurorahyprland/bin/quickshell}
CONFIG=$OMARCHY_PATH/shell
export PATH="$OMARCHY_PATH/bin:/opt/aurorahyprland/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
# AuroraHyprland itself uses null EGL; shell windows are android_wlegl clients.
export EGL_PLATFORM=wayland HYBRIS_EGLPLATFORM=wayland QT_QPA_PLATFORM=wayland
export QSG_RHI_BACKEND=opengl QSG_RENDER_LOOP=basic AURORA_OPAL_GLES=1
export GDK_BACKEND=wayland

[ -x "$QUICKSHELL" ] || { echo "aurora-omarchy: missing Opal QuickShell runtime at $QUICKSHELL" >&2; exit 127; }
[ -r "$CONFIG/shell.qml" ] || { echo "aurora-omarchy: missing $CONFIG/shell.qml" >&2; exit 2; }

case "${1:-start}" in
    start)
        if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
            # The shell must talk to Hyprland over its socket; launching
            # without a signature leaves a crippled bar (no workspaces).
            # The compositor may still be starting, so wait for the socket
            # instead of degrading. The supervisor relaunches on failure.
            tries=0
            while [ "$tries" -lt 30 ]; do
                for instance in "$XDG_RUNTIME_DIR"/hypr/*; do
                    [ -S "$instance/.socket.sock" ] || continue
                    # Dead runs leave their sockets behind. Only a live
                    # Hyprland accepts connections; ignore the rest.
                    if command -v python3 >/dev/null 2>&1; then
                        python3 -c 'import socket,sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(2)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(1)' "$instance/.socket.sock" 2>/dev/null || continue
                    fi
                    [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || {
                        echo 'aurora-omarchy: multiple Hyprland instances; set HYPRLAND_INSTANCE_SIGNATURE' >&2
                        exit 2
                    }
                    HYPRLAND_INSTANCE_SIGNATURE=${instance##*/}
                done
                [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && break
                tries=$((tries + 1))
                sleep 1
            done
            if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
                echo 'aurora-omarchy: no Hyprland socket after 30s' >&2
                exit 2
            fi
            export HYPRLAND_INSTANCE_SIGNATURE
        fi
        mkdir -p "$HOME/.config/omarchy" "$HOME/.local/bin"
        [ -f "$HOME/.config/omarchy/shell.json" ] || cp "$OMARCHY_PATH/config/omarchy/shell.json" "$HOME/.config/omarchy/shell.json"
        "$OMARCHY_PATH/bin/aurora-omarchy-compat" --install-links "$HOME/.local/bin"
        export PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:$PATH"
        exec "$QUICKSHELL" -n -p "$CONFIG"
        ;;
    stop) exec "$QUICKSHELL" kill -p "$CONFIG" ;;
    reload)
        "$QUICKSHELL" kill -p "$CONFIG" || true
        exec "$0" start
        ;;
    menu) exec "$QUICKSHELL" ipc -p "$CONFIG" call shell toggle omarchy.menu '{"menu":"root"}' ;;
    apps) exec "$QUICKSHELL" ipc -p "$CONFIG" call shell toggle omarchy.menu '{"menu":"apps"}' ;;
    audio) exec "$QUICKSHELL" ipc -p "$CONFIG" call shell toggle omarchy.audio '{}' ;;
    ipc)
        shift
        exec "$QUICKSHELL" ipc -p "$CONFIG" call "$@"
        ;;
    check) echo 'aurora-omarchy: files ready (not a graphics qualification)' ;;
    *) echo 'usage: aurora-omarchy [start|stop|reload|menu|apps|audio|ipc TARGET METHOD ...|check]' >&2; exit 2 ;;
esac
