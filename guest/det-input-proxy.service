[Unit]
Description=Determination USB/Bluetooth input compositor proxy
After=seatd.service

[Service]
Type=simple
User=detuser
Group=detuser
EnvironmentFile=-/etc/determination-device.conf
ExecStart=/usr/local/bin/det-input-proxy-session
Restart=on-failure
RestartSec=2
TimeoutStopSec=3
StandardOutput=journal
StandardError=journal
