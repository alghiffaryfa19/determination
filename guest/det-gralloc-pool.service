[Unit]
Description=Determination Android gralloc pool broker
After=dbus.service

[Service]
Type=simple
RuntimeDirectory=determination
RuntimeDirectoryMode=0755
Environment=DET_PLASMA_WIDTH=1920
Environment=DET_PLASMA_HEIGHT=1080
Environment=DET_GRALLOC_POOL_SIZE=3
ExecStart=/usr/local/bin/det-gralloc-pool-session
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
