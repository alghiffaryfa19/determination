#!/usr/bin/env python3
"""aurora-sliderd - alert slider support for Aurora guests.

Kernel ground truth (drivers/misc/tri_state_key/oplus_tri_key.c,
guacamoleb downstream): the oplus hall switch emits KEY_F3 press events
whose VALUE encodes physical position - 1=up(ring) 2=middle(vibrate)
3=down(silent) - followed by a value-0 release. libinput discards
nonstandard key values, so without this daemon the hardware switch just
types stray F3 presses into whatever has focus.
"""

import os
import struct
import subprocess
import sys
import shutil
import time

DEV_NAME = "oplus,hall_tri_state_key"
KEY_F3 = 61
EV_KEY = 1
CONF = "/etc/aurora/slider.conf"


def log(msg):
    print(f"sliderd: {msg}", flush=True)


def find_node():
    want = None
    with open("/proc/bus/input/devices") as f:
        name_seen = False
        for line in f:
            if line.startswith("N:"):
                name_seen = DEV_NAME in line
            elif name_seen and line.startswith("H:"):
                # A device whose ONLY handler is its event node renders as
                # "H: Handlers=eventN" - strip the prefix before matching.
                for tok in line.split():
                    tok = tok.replace("Handlers=", "")
                    if tok.startswith("event"):
                        want = "/dev/input/" + tok.rstrip()
                break
    return want


def which(*names):
    for n in names:
        p = shutil.which(n)
        if p:
            return p
    return None


def run_quiet(cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except Exception:
        pass


def notify(summary):
    ns = which("notify-send")
    if ns:
        run_quiet([ns, "-a", "Aurora", summary])


def haptic_tick():
    # feedbackd's CLI when packaged; harmless no-op otherwise.
    fbd = which("fbdctl", "feedbackdctl")
    if fbd:
        run_quiet([fbd, "pattern", "touch"])


def apply_position(pos):
    # Defaults follow Android semantics. Override per-position commands in
    # CONF ("pos<N>=<argv joined by spaces>") if desired.
    custom = None
    if os.path.isfile(CONF):
        for line in open(CONF):
            line = line.strip()
            if line.startswith(f"pos{pos}="):
                custom = line.split("=", 1)[1]
                break
    if custom:
        subprocess.Popen(custom, shell=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    wp = which("wpctl")
    if not wp:
        return
    sink = "@DEFAULT_AUDIO_SINK@"
    if pos == 1:      # up: ring
        run_quiet([wp, "set-mute", sink, "0"])
        notify("Ring")
    elif pos == 2:    # middle: vibrate (media keeps playing, ringer quieted)
        haptic_tick()
        notify("Vibrate")
    elif pos == 3:    # down: silent
        run_quiet([wp, "set-mute", sink, "1"])
        notify("Silent")


def main():
    node = find_node()
    if not node:
        log(f"no {DEV_NAME} input device; exiting")
        return 1
    try:
        fd = os.open(node, os.O_RDONLY)
    except PermissionError:
        log(f"cannot read {node} - are you in android_input?")
        return 1
    log(f"watching {node}")
    # arm64 input_event: timeval(16B) + u16 type + u16 code + s32 value.
    fmt = "<qqHHi"
    while True:
        data = os.read(fd, struct.calcsize(fmt))
        if len(data) < struct.calcsize(fmt):
            time.sleep(0.1)
            continue
        _, _, etype, code, value = struct.unpack(fmt, data)
        if etype == EV_KEY and code == KEY_F3 and value in (1, 2, 3):
            apply_position(value)


if __name__ == "__main__":
    sys.exit(main())
