#!/system/bin/sh
# Desktop-to-phone handoff: release composer before restarting SurfaceFlinger.

set -u
AURORA=${AURORA:-/data/aurora}
. "$AURORA/bin/lifecycle-lib"
emergency=0
case "${1:-}" in
    "") ;;
    --emergency) emergency=1 ;;
    *) echo "usage: desktop-off [--emergency]" >&2; exit 2 ;;
esac
exec >>"$AURORA/log/toggle.log" 2>&1
echo "--- desktop-off $(date)"
lc_lock_acquire || exit 1
generation=$(sed -n 's/^generation=//p' "$AURORA/run/transition.state" 2>/dev/null | tail -n 1)
[ -n "$generation" ] || generation=0
signal_generation=$generation
[ "$emergency" -eq 0 ] || signal_generation=
lc_state_write EXITING "$generation" preflight running
finish() { lc_lock_release; }
trap finish EXIT HUP INT TERM

# Stop the suppressor before restarting SF.
rm -f "$AURORA/run/desktop-mode"
lc_pid_signal suppressor TERM "$signal_generation"
"$AURORA/bin/external-input" stop >/dev/null 2>&1 || true
lc_state_write EXITING "$generation" android-owner running

# SIGCONT would resume system_server with fatal accumulated Watchdog time.
lc_pid_signal ss-freezer TERM "$signal_generation"
sspid=$(pidof system_server 2>/dev/null)
[ -n "$sspid" ] && kill -KILL "$sspid" 2>/dev/null

# Keep the lazy health HAL registered while the new system_server boots.
# Without it, ChargingControlController blocks and Watchdog loops forever.
if [ "$(getprop sys.boot_completed)" = "1" ]; then
    setsid sh -c '
        end=$(( $(date +%s) + 120 ))
        while [ "$(date +%s)" -lt "$end" ]; do
            [ "$(getprop init.svc.vendor.lineage_health)" = "running" ] || start vendor.lineage_health
            sleep 2
        done
    ' </dev/null >/dev/null 2>&1 &
fi

# Teardown targets come from desktop-on's session.active record; defaults = phosh.
active_field() {
    sed -n "s/^$1=//p" "$AURORA/run/session.active" 2>/dev/null | head -n 1
}
active_id=$(active_field id)
active_compositor=$(active_field compositor)
active_shell=$(active_field shell)
active_backend=$(active_field backend)
if [ -z "$active_compositor" ]; then
    active_record=$("$AURORA/bin/session-select" 2>/dev/null) || active_record=
    if [ -n "$active_record" ]; then
        active_id=$(printf '%s\n' "$active_record" | sed -n 's/^id=//p' | head -n 1)
        active_compositor=$(printf '%s\n' "$active_record" | sed -n 's/^compositor=//p' | head -n 1)
        active_shell=$(printf '%s\n' "$active_record" | sed -n 's/^shell=//p' | head -n 1)
        active_backend=$(printf '%s\n' "$active_record" | sed -n 's/^backend=//p' | head -n 1)
    fi
fi
: "${active_id:=phosh}"
: "${active_compositor:=/usr/local/bin/phoc}"
comp_name=${active_compositor##*/}

# Terminate clients before the compositor so wlroots releases composer cleanly.
lc_state_write EXITING "$generation" compositor running
if [ "$active_backend" = gralloc-minigbm ]; then
    # Stop the unit first or systemd respawns what we just killed.
    "$AURORA/lxc/bin/lxc-attach" -P "$AURORA" -n guest -- /bin/sh -c \
        'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; \
         systemctl stop aurora-plasma.service 2>/dev/null; true' 2>/dev/null
fi
if [ "${active_shell##*/}" = phosh ]; then
    "$AURORA/lxc/bin/lxc-attach" -P "$AURORA" -n guest -- /bin/sh -c \
        'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; \
         [ "$(aurora-platform init 2>/dev/null)" != systemd ] || \
             systemctl stop aurora-phosh.service 2>/dev/null || true' 2>/dev/null
fi
"$AURORA/lxc/bin/lxc-attach" -P "$AURORA" -n guest -- /bin/sh -c '
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    for client in "$1" squeekboard foot ${2:+plasmashell}; do
        [ -n "$client" ] && pkill -TERM "$client"
    done
    true' client-kill "${active_shell##*/}" "$active_backend" 2>/dev/null
i=0
while pgrep -x "${active_shell##*/}" >/dev/null 2>&1 || pgrep -x foot >/dev/null 2>&1 ||
      { [ "$active_backend" = gralloc-minigbm ] && pgrep -x plasmashell >/dev/null 2>&1; }; do
    i=$((i+1)); [ $i -gt 15 ] && { echo "WARN: clients still up after 1.5s --- proceeding"; break; }
    sleep 0.1
done
"$AURORA/lxc/bin/lxc-attach" -P "$AURORA" -n guest -- /usr/bin/pkill -TERM "$comp_name" 2>/dev/null
lc_pid_signal compositor TERM "$signal_generation"
lc_pid_signal client TERM "$signal_generation"
# The compositor must be gone before SF binds the single-client HAL.
i=0
while pgrep -x "$comp_name" >/dev/null 2>&1; do
    i=$((i+1)); [ $i -gt 30 ] && {
        echo "RECOVERY: $comp_name still owns resources after TERM; refusing SF start"
        "$AURORA/lxc/bin/lxc-attach" -P "$AURORA" -n guest -- /usr/bin/pkill -KILL "$comp_name" 2>/dev/null
        sleep 0.5
        pgrep -x "$comp_name" >/dev/null 2>&1 && { lc_state_write RECOVERY "$generation" compositor ambiguous; exit 1; }
        break
    }
    sleep 0.1
done
rm -f "$AURORA/run/session.active"
sleep 0.5

# Raw-KMS sessions stopped the composer HAL and wedge the color HALs; restore
# both BEFORE system_server respawns (sequence from native-restore).
if [ "$active_backend" = gralloc-minigbm ]; then
    echo detect > /sys/class/drm/card0-Virtual-1/status 2>/dev/null
    if [ "$(getprop init.svc.vendor.hwcomposer-2-4)" != "running" ]; then
        start vendor.hwcomposer-2-4
        sleep 2
    fi
    stop vendor.livedisplay-hal 2>/dev/null
    stop display-color-hal-1-0 2>/dev/null
    sleep 1
    start display-color-hal-1-0 2>/dev/null
    sleep 1
    start vendor.livedisplay-hal 2>/dev/null
fi

# Restore journalled Android audio ownership without blocking display recovery.
lc_state_write EXITING "$generation" audio running
# Drain reparented PipeWire processes before probing ALSA ownership.
"$AURORA/lxc/bin/lxc-attach" -P "$AURORA" -n guest -- /bin/sh -c '
    lock=/run/user/1000/aurora-audio-session.lock/owner
    owner=$(cat "$lock" 2>/dev/null || true)
    case "$owner" in *[!0-9]*|'') ;; *) kill -TERM "$owner" 2>/dev/null || true ;; esac
    pkill -TERM -x wireplumber 2>/dev/null || true
    pkill -TERM -x pipewire-pulse 2>/dev/null || true
    pkill -TERM -x pipewire 2>/dev/null || true
    i=0
    while pgrep -x wireplumber >/dev/null 2>&1 ||
          pgrep -x pipewire-pulse >/dev/null 2>&1 ||
          pgrep -x pipewire >/dev/null 2>&1; do
        i=$((i + 1)); [ "$i" -lt 30 ] || break
        sleep 0.1
    done
    pkill -KILL -x wireplumber 2>/dev/null || true
    pkill -KILL -x pipewire-pulse 2>/dev/null || true
    pkill -KILL -x pipewire 2>/dev/null || true
' 2>/dev/null || true
if [ -x "$AURORA/bin/aurora-audio-route" ] && \
   [ -f "$AURORA/run/audio-route.state" ]; then
    "$AURORA/bin/aurora-audio-route" restore ||
        echo "WARN: direct audio route restore failed; run auroractl doctor"
elif [ -x "$AURORA/bin/aurora-audio-owner" ] && \
   [ -f "$AURORA/etc/audio-owner.conf" ] && \
   [ -f "$AURORA/run/audio-owner.state" ]; then
    audio_phase=$(sed -n 's/^phase=//p' "$AURORA/run/audio-owner.state" | tail -n 1)
    case "$audio_phase" in
        claimed|restoring|restore-failed)
            "$AURORA/bin/aurora-audio-owner" restore --apply ||
                echo "WARN: direct audio restore failed; run auroractl doctor"
            ;;
    esac
fi

lc_state_write EXITING "$generation" surfaceflinger running
start surfaceflinger
i=0
until [ "$(getprop init.svc.surfaceflinger)" = "running" ]; do
    i=$((i+1)); [ $i -gt 20 ] && echo "WARN: SF slow to return" && break
    sleep 0.5
done

# A restarted SF resets bootanim's exit property, so signal it after startup.
lc_state_write EXITING "$generation" android-ui running
if [ "$(getprop sys.boot_completed)" = "1" ]; then
    i=0
    while [ $i -lt 20 ]; do
        [ "$(getprop init.svc.bootanim)" = "running" ] && break
        i=$((i+1)); sleep 0.5
    done
    if [ "$(getprop init.svc.bootanim)" = "running" ]; then
        setprop service.bootanim.exit 1
        setprop service.bootanim.progress 1
        i=0
        while [ "$(getprop init.svc.bootanim)" = "running" ] && [ $i -lt 10 ]; do
            i=$((i+1)); sleep 0.5
        done
        [ "$(getprop init.svc.bootanim)" = "running" ] && stop bootanim && echo "bootanim would not exit --- stopped it"
        echo "boot animation cleared"
    fi
    # Cover late bootanim starts after the initial wait window.
    setsid sh -c '
        end=$(( $(date +%s) + 60 ))
        while [ "$(date +%s)" -lt "$end" ]; do
            if [ "$(getprop init.svc.bootanim)" = "running" ]; then
                setprop service.bootanim.exit 1
                setprop service.bootanim.progress 1
                sleep 3
                [ "$(getprop init.svc.bootanim)" = "running" ] && stop bootanim
            fi
            sleep 1
        done
    ' </dev/null >/dev/null 2>&1 &
fi

# Release any surviving host input grab only after Android UI returns.
lc_state_write EXITING "$generation" input running
lc_pid_signal evgrab TERM "$signal_generation"
rm -f "$AURORA/run/evgrab.legacy.pid"
"$AURORA/bin/desktop-memory" release "$generation" ||
    echo "WARN: desktop memory state release failed"
lc_state_write PHONE "$generation" complete committed
echo "phone mode restored"

# Optional battery policy stops the idle guest in phone mode.
if [ -f "$AURORA/etc/stop-guest-on-exit" ]; then
    echo "stop-guest-on-exit set --- stopping guest"
    "$AURORA/lxc/bin/lxc-stop" -P "$AURORA" -n guest -t 10 2>/dev/null
fi
