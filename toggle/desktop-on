#!/system/bin/sh
# Determination internal-panel handoff, phone -> desktop (spec §4).
# Single-client composer HAL: SF must release it before the guest compositor
# can bind. The respawn fight is the real engineering here, not the stop.
# Installed to /data/determination/bin/. Run as root.

set -u
DET=${DET:-/data/determination}
LOG=$DET/log/toggle.log
. "$DET/bin/device-config"
. "$DET/bin/lifecycle-lib"
# Rotate the append-forever log once it passes ~256K (keep the newest half).
[ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 262144 ] &&
    tail -c 131072 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
exec >>"$LOG" 2>&1
echo "--- desktop-on $(date)"

# 0. Preconditions: claim the transition before any helper can inspect state.
[ -f "$DET/run/desktop-mode" ] && { echo "already in desktop mode"; exit 0; }
mkdir -p "$DET/run"
lc_lock_acquire || exit 1
generation=$(lc_generation_next)
lc_state_write ENTERING "$generation" preflight running || { lc_lock_release; exit 1; }
# The marker is deliberately first. The suppressor must never observe a missing
# marker after it has been launched.
touch "$DET/run/desktop-mode"
# Snapshot Android-owned connectivity while framework services still answer.
# The guest connectivity bridge serves this read-only cache after system_server
# is frozen; mutations remain disabled until phone/external-display mode.
mkdir -p "$DET/run/connectivity-cache"
timeout 8 cmd wifi status > "$DET/run/connectivity-cache/wifi-status" 2>/dev/null || true
timeout 8 cmd wifi list-networks > "$DET/run/connectivity-cache/wifi-list" 2>/dev/null || true
case "$(timeout 5 settings get global bluetooth_on 2>/dev/null)" in
    1) echo on > "$DET/run/connectivity-cache/bt-status" ;;
    0) echo off > "$DET/run/connectivity-cache/bt-status" ;;
esac
rollback() {
    rc=$?
    if [ "$rc" -ne 0 ] && [ -f "$DET/run/desktop-mode" ]; then
        echo "desktop-on failed at state $(sed -n 's/^step=//p' "$DET/run/transition.state" 2>/dev/null); restoring phone"
        rm -f "$DET/run/desktop-mode"
        lc_pid_signal suppressor TERM "$generation"
        lc_pid_signal ss-freezer TERM "$generation"
        lc_pid_signal evgrab TERM "$generation"
        if [ -x "$DET/bin/det-audio-route" ] &&
           [ -f "$DET/run/audio-route.state" ]; then
            "$DET/bin/det-audio-route" restore || true
        fi
        start surfaceflinger 2>/dev/null || true
        lc_state_write RECOVERY "$generation" rollback failed || true
    fi
    lc_lock_release
}
trap rollback EXIT HUP INT TERM

# desktop-off may intentionally stop the guest to return resources to Android.
# The old script assumed the boot service always kept LXC alive and could
# commit DESKTOP with a frozen system_server even when every lxc-attach had
# failed. Start it while Android still owns the display, then enforce the
# actual state before touching input or SurfaceFlinger.
lc_state_write ENTERING "$generation" guest running
"$DET/bin/guest-start" || { echo "guest-start failed"; exit 1; }
guest_state=$("$DET/lxc/bin/lxc-info" -P "$DET" -n guest -sH 2>/dev/null)
[ "$guest_state" = RUNNING ] || {
    echo "guest failed to reach RUNNING state (state=${guest_state:-unknown})"
    exit 1
}

# 1. Input first: grab evdev nodes so Android stops seeing events *before* its
#    UI disappears (avoids a window where touches land on invisible UI).
#    evgrab holds EVIOCGRAB on every touchscreen/key node until killed.
"$DET/bin/evgrab" -a -p "$DET/run/evgrab.legacy.pid" || { echo "evgrab failed"; exit 1; }
evgrab_pid=$(sed -n 's/^pid=//p' "$DET/run/evgrab.legacy.pid" 2>/dev/null | head -n 1)
[ -n "$evgrab_pid" ] || evgrab_pid=$(sed -n '1p' "$DET/run/evgrab.legacy.pid" 2>/dev/null)
case "$evgrab_pid" in ''|*[!0-9]*) echo "evgrab identity unavailable"; exit 1;; esac
lc_pid_write evgrab "$evgrab_pid" "$generation" || { echo "evgrab identity unavailable"; exit 1; }
lc_state_write ENTERING "$generation" display-owner running

# 2. Stop SurfaceFlinger and its dependents-in-fact.
stop bootanim
stop surfaceflinger

# 3. Suppress re-start. Known re-issuers of `start surfaceflinger`:
#    system_server SF-death handling, bootanim, class_restart. An explicit
#    init `stop` is honoured but doesn't survive those. Bring-up approach: a
#    suppressor loop re-asserting the stop. The Zygisk hook (milestone 6)
#    handles this in-process now; the loop is a fallback + backlight keeper.
#    The same loop doubles as the backlight keeper (see 4b): every SF stop ---
#    including the suppressor's own re-stops --- zeroes the panel backlight, so
#    re-asserting both in one loop is not just cheaper, it's more correct.
BL_LEVEL=$DET_BACKLIGHT_LEVEL
BL=$DET_BACKLIGHT_PATH
(
    while [ -f "$DET/run/desktop-mode" ]; do
        [ "$(getprop init.svc.surfaceflinger)" = "running" ] && {
            echo "suppressor: SF respawned, re-stopping ($(date))"
            stop surfaceflinger
        }
        [ -n "$BL" ] && echo "$BL_LEVEL" > "$BL" 2>/dev/null
        sleep 1
    done
) &
lc_pid_write suppressor "$!" "$generation" || exit 1

# 3b. system_server freezer: SIGSTOP any running system_server so its
#     framework Watchdog can't fire. Without this, the display thread blocks
#     60s in SurfaceControl.nativeApplyTransaction (BLAST sync to stopped SF),
#     Watchdog kills system_server, init/zygote respawns it, ~78s crash loop
#     --- which thrashes netd and takes wlan0 down. Freezing keeps ss suspended
#     for the entire session; desktop-off SIGKILLs it (SIGCONT would just
#     unblock the Watchdog with accumulated block time and it'd self-kill).
#     Tick fast (200ms) so a fresh ss is caught before it can touch netd.
(
    while [ -f "$DET/run/desktop-mode" ]; do
        pid=$(pidof system_server 2>/dev/null)
        if [ -n "$pid" ]; then
            state=$(awk '/^State:/{print $2; exit}' /proc/$pid/status 2>/dev/null)
            if [ "$state" != "T" ] && [ "$state" != "t" ]; then
                kill -STOP "$pid" 2>/dev/null &&
                    echo "ss-freezer: STOPped system_server pid=$pid state=$state $(date)"
            fi
        fi
        sleep 0.2
    done
) &
lc_pid_write ss-freezer "$!" "$generation" || exit 1

# 4. Wait for SF to actually release the composer client + GPU context.
i=0
while [ "$(getprop init.svc.surfaceflinger)" != "stopped" ]; do
    i=$((i+1)); [ $i -gt 20 ] && { echo "SF didn't stop"; exit 1; }
    sleep 0.5
done
# The composer HAL process itself keeps running (it's a vendor service; SF is
# its *client*). Give the HAL a beat to drop the client state.
sleep 1

# 4b. Stopping SF zeroes the panel backlight (found 2026-07-04: guest renders
# were reaching scanout but the light was off --- the panel wasn't "dark", it
# was unlit). Force it back on; desktop-off restores Android's own control.
# ACTIVE node is backlight/ (max 4095); panel0-backlight is inert (2026-07-05
# fill-run: frames visible while panel0-backlight=0).
# BL_LEVEL: 1400/4095 (~34%). Lowered from 2048 for OLED burn-in --- the idle
# blank is disabled (broken wake path) so the panel stays lit the whole
# session; lower luminance + the dark UI theme cut the burn-in rate. Still
# very readable indoors. Bump it if you're outdoors. (BL_LEVEL/BL are set at
# step 3 --- the suppressor loop doubles as the keeper.)
[ -n "$BL" ] && echo "$BL_LEVEL" > "$BL" 2>/dev/null

# 4c. Standalone owner transition. SF is gone and phoc has not started yet, so
# this finite libhybris/GLES client can acquire HWC without fighting either
# system. It lands on black and releases cleanly. Cosmetic and timeout-bounded:
# display recovery always wins if the renderer is absent or broken.
lc_state_write ENTERING "$generation" animation running
"$DET/bin/run-transition" desktop ||
    echo "WARN: native desktop transition skipped/failed rc=$? (see log/transition.log)"

# 4d. Claim the internal codec and apply the exact guacamoleb speaker route.
# The guest session below starts PipeWire only while the owner's marker exists.
# Audio failure is non-fatal to display handoff and remains recoverable through
# the route and ownership journals.
if [ -x "$DET/bin/det-audio-route" ] &&
   [ -f "$DET/etc/audio-owner.conf" ]; then
    lc_state_write ENTERING "$generation" audio running
    # A previous phone restore can time out waiting for a guest graph and leave
    # a restore-failed journal. Android subsequently restarts its own audio HAL,
    # so a later recover sees those legitimate holders and cannot distinguish
    # them from unreleased guest ALSA. At this point system_server is frozen and
    # desktop mode is taking ownership anyway: quiesce the profile services,
    # finish the old restore transaction, then make the normal fresh claim.
    audio_phase=$(sed -n 's/^phase=//p' "$DET/run/audio-owner.state" 2>/dev/null | tail -n 1)
    case "$audio_phase" in
        restoring|restore-failed)
            echo "recovering stale direct-audio journal phase=$audio_phase"
            for audio_service in $(sed -n 's/^service=//p' "$DET/etc/audio-owner.conf"); do
                stop "$audio_service" 2>/dev/null || true
            done
            "$DET/bin/det-audio-owner" recover --apply ||
                echo "WARN: stale direct-audio journal recovery failed"
            ;;
    esac
    "$DET/bin/det-audio-route" claim ||
        echo "WARN: direct audio claim failed; desktop continues muted"
fi

# 5. THE REAL COMPOSITOR (2026-07-06): phoc 0.47 (droidian group/102) on the
#    droidian wlroots hwcomposer backend, built in-guest against upstream
#    libhybris --- guest/build-wlroots-phoc.sh. First light + 40s soak:
#    artifacts/guest-phoc-foot-v2-20260706.txt.
#
#    Hard-won constraints encoded below:
#      - phoc must NOT be started with -E: glib's child watch is broken on
#        this pidfd-less 4.14 kernel (waitid(P_PIDFD) EINVAL) --- phoc
#        mis-reads the session child as dead and shuts down. Compositor and
#        clients are launched separately.
#      - stdbuf -oL or compositor.log stays empty (block-buffered stdout).
#      - stale wayland-0 socket+lock must be removed pre-launch or a
#        relaunched phoc silently binds wayland-1 and clients miss it.
#      - backlight keeper: an SF stop zeroes the backlight; the step-3
#        suppressor loop re-asserts BL_LEVEL every 1s (see 4b --- ~34% for
#        burn-in). ACTIVE node is backlight/ (max 4095); panel0-backlight
#        is inert (2026-07-05). phoc's wlroots also sets composer-client
#        brightness 1.0 after power-on (the SDM DSPP-dim fix, b182d86) ---
#        the keeper handles only the sysfs backlight.
#      - supervisor relaunches phoc only on DEATH, with fast-fail backoff;
#        desktop-off clears desktop-mode first, so intentional teardown is
#        not treated as a crash.
#    Input (§4, 2026-07-06): phoc now runs backends hwcomposer,libinput.
#    The libinput backend needs (a) seatd (wlr_session via libseat), and
#    (b) /run/udev/data entries so libinput accepts devices --- udevd cannot
#    run in the container (ro /sys), so det-input-udevdb (guest/
#    setup-input.sh) hand-writes them per boot. Our wlroots patch takes
#    EVIOCGRAB on every node libinput opens. Step 5d transfers ownership only
#    after system_server is frozen. If setup-input.sh has not run yet, fall
#    back to hwcomposer-only (display works, no input).
#
# 5d. Input handoff (§4): waiting for wayland-0 was a race because current
# phoc creates it only ~30ms before libinput initialization. Milestone 6 gives
# us a stronger boundary: system_server is already SIGSTOPped, so Android
# cannot consume events. Verify that invariant, release the host grab, and
# only then start phoc so it can take EVIOCGRAB immediately.
ss_pid=$(pidof system_server 2>/dev/null)
ss_state=
[ -z "$ss_pid" ] || ss_state=$(awk '/^State:/{print $2; exit}' "/proc/$ss_pid/status" 2>/dev/null)
case "$ss_state" in
    T|t)
        lc_pid_signal evgrab TERM "$generation"
        rm -f "$DET/run/evgrab.legacy.pid"
        echo "input boundary handed to guest --- system_server frozen $(date)"
        ;;
    *)
        echo "system_server is not frozen at input handoff (pid=$ss_pid state=$ss_state)"
        exit 1
        ;;
esac
CLOG="$DET/log/compositor.log"
: > "$CLOG"
lc_state_write ENTERING "$generation" compositor running
(
    fails=0
    while [ -f "$DET/run/desktop-mode" ]; do
        echo "--- launch phoc (prior consecutive fast-fails: $fails) $(date)" >> "$CLOG"
        t0=$(date +%s)
        # Root-only prep: the udev DB and seatd need root (write /run/udev,
        # start a system unit), and melissa's XDG_RUNTIME_DIR must be created
        # for her before phoc (which now runs UNPRIVILEGED --- see below) starts.
        # Idempotent; re-runs harmlessly each relaunch.
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            install -d -o melissa -g melissa -m 700 /run/user/1000
            # phoc runs as melissa now, so its config must be world-readable ---
            # it ships 0640 root:root and phoc SEGFAULTS on a failed parse.
            chmod a+r /etc/phoc.ini 2>/dev/null || true
            if [ -x /usr/local/sbin/det-input-udevdb ]; then
                det-input-udevdb 2>/dev/null && det-platform service-start seatd 2>/dev/null
            fi' >> "$CLOG" 2>&1
        # Compositor runs as melissa (uid 1000), NOT root: seatd hands it the
        # input/drm fds (socket is group video, melissa is in it) and the GPU/
        # dri/binder nodes are world-rw or 1000-owned (recon 2026-07-12).
        # runuser -u keeps her supplementary groups (android_input for /dev/input);
        # HOME/USER must be set explicitly (runuser -u does not start a login
        # shell). WLR_BACKENDS is decided here from seatd's live state since the
        # root prep above owns the start.
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- \
            /usr/local/bin/det-platform run-user melissa /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            export HOME=/home/melissa USER=melissa LOGNAME=melissa
            export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/aarch64-linux-gnu
            export HYBRIS_LD_LIBRARY_PATH=/usr/lib/android:/vendor/lib64:/system/lib64:/odm/lib64:/apex/com.android.runtime/lib64/bionic
            export EGL_PLATFORM=hwcomposer HYBRIS_EGLPLATFORM=hwcomposer ANDROID_ROOT=/system TMPDIR=/tmp
            export XDG_RUNTIME_DIR=/run/user/1000 LANG=C.UTF-8
            if det-platform service-active seatd; then
                WLR_BACKENDS=hwcomposer,libinput
            else
                WLR_BACKENDS=hwcomposer
            fi
            export WLR_BACKENDS LIBSEAT_BACKEND=seatd
            [ -r /etc/determination-device.conf ] && . /etc/determination-device.conf
            [ -z "${DET_PANEL_REFRESH_MHZ:-}" ] ||
                export WLR_HWC_REFRESH_MHZ="$DET_PANEL_REFRESH_MHZ"
            [ -f /usr/local/lib/det-pidfd-shim.so ] &&
                export LD_PRELOAD=/usr/local/lib/det-pidfd-shim.so
            rm -f "$XDG_RUNTIME_DIR"/wayland-0 "$XDG_RUNTIME_DIR"/wayland-0.lock
            exec stdbuf -oL -eL /usr/local/bin/phoc -C /etc/phoc.ini
        ' >> "$CLOG" 2>&1
        rc=$?
        dur=$(( $(date +%s) - t0 ))
        [ -f "$DET/run/desktop-mode" ] || { echo "phoc exited rc=$rc after ${dur}s --- desktop mode off, stopping $(date)" >> "$CLOG"; break; }
        if [ "$dur" -lt 5 ]; then
            fails=$((fails+1))
            back=$fails; [ "$back" -gt 10 ] && back=10
            echo "FAST-FAIL: phoc died in ${dur}s rc=$rc (consecutive=$fails); backing off ${back}s $(date)" >> "$CLOG"
            sleep "$back"
        else
            echo "phoc exited rc=$rc after ${dur}s (ran long --- not a fast-fail); relaunching $(date)" >> "$CLOG"
            fails=0
            sleep 1
        fi
    done
) &
lc_pid_write compositor "$!" "$generation" || exit 1

# 5e. Session clients: phosh (mobile shell) + squeekboard (OSK) on the
# phoc socket, sharing one dbus session bus. The pidfd shim is MANDATORY
# for phosh: glib child-watch dies on this kernel's half-backported pidfd
# (pidfd_open works, waitid(P_PIDFD) EINVAL) and app launching would
# break. Falls back to a bare foot terminal if phosh isn't installed.
(
    while [ -f "$DET/run/desktop-mode" ]; do
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            # systemd guests get a real PAM/logind login session. This is the
            # difference between merely drawing Phosh and applications seeing
            # a first-class graphical desktop. Experimental OpenRC guests keep
            # the direct launcher until their elogind path is qualified.
            if [ "$(det-platform init)" = systemd ] &&
                    [ -f /etc/systemd/system/det-phosh.service ]; then
                systemctl stop det-phosh.service 2>/dev/null || true
                det-platform service-start det-phosh || exit 10
                while det-platform service-active det-phosh; do sleep 1; done
                journalctl -u det-phosh.service -n 100 --no-pager 2>/dev/null || true
                exit 11
            fi
            exec det-platform run-user melissa /usr/local/bin/det-phosh-session
        ' >> "$CLOG" 2>&1
        [ -f "$DET/run/desktop-mode" ] || break
        sleep 2
    done
) &
lc_pid_write client "$!" "$generation" || exit 1
lc_state_write DESKTOP "$generation" session committed
trap - EXIT HUP INT TERM
lc_lock_release
if [ -x "$DET/bin/external-input" ]; then
    "$DET/bin/external-input" start >/dev/null 2>&1 ||
        echo "WARN: USB/Bluetooth peripheral bridge did not start"
fi
echo "desktop mode up (phoc + phosh session; log/compositor.log)"
