#!/system/bin/sh
# Internal-panel handoff: SurfaceFlinger must release the single-client HAL.

set -u
DET=${DET:-/data/determination}
LOG=$DET/log/toggle.log
. "$DET/bin/device-config"
. "$DET/bin/lifecycle-lib"
# guacamoleb recon: composer service name is stable across this Android line.
HWC_SVC=vendor.hwcomposer-2-4
[ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 262144 ] &&
    tail -c 131072 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
exec >>"$LOG" 2>&1
echo "--- desktop-on $(date)"

# Claim the transition before helpers can inspect it.
[ -f "$DET/run/desktop-mode" ] && { echo "already in desktop mode"; exit 0; }
mkdir -p "$DET/run"
lc_lock_acquire || exit 1
generation=$(lc_generation_next)
lc_state_write ENTERING "$generation" preflight running || { lc_lock_release; exit 1; }
# The suppressor requires this marker before it starts.
touch "$DET/run/desktop-mode"
# Cache connectivity reads before system_server is frozen.
mkdir -p "$DET/run/connectivity-cache"
timeout 8 cmd wifi status > "$DET/run/connectivity-cache/wifi-status" 2>/dev/null || true
timeout 8 cmd wifi list-networks > "$DET/run/connectivity-cache/wifi-list" 2>/dev/null || true
case "$(timeout 5 settings get global bluetooth_on 2>/dev/null)" in
    1) echo on > "$DET/run/connectivity-cache/bt-status" ;;
    0) echo off > "$DET/run/connectivity-cache/bt-status" ;;
esac
rollback() {
    rc=$?
    if [ "$rc" -ne 0 ] && [ -f "$DET/run/desktop-mode" ]; then
        echo "desktop-on failed at state $(sed -n 's/^step=//p' "$DET/run/transition.state" 2>/dev/null); restoring phone"
        rm -f "$DET/run/desktop-mode"
        lc_pid_signal suppressor TERM "$generation"
        lc_pid_signal ss-freezer TERM "$generation"
        lc_pid_signal evgrab TERM "$generation"
        # Raw-KMS entry stops the composer HAL; put it back before SF.
        if [ "${sess_backend:-}" = gralloc-minigbm ]; then
            echo detect > /sys/class/drm/card0-Virtual-1/status 2>/dev/null
            [ "$(getprop init.svc.$HWC_SVC)" = running ] || start $HWC_SVC 2>/dev/null || true
            sleep 1
        fi
        if [ -x "$DET/bin/det-audio-route" ] &&
           [ -f "$DET/run/audio-route.state" ]; then
            "$DET/bin/det-audio-route" restore || true
        fi
        start surfaceflinger 2>/dev/null || true
        # Raw-KMS entry can leave bootanim wedged on its final frame; keep
        # signalling exit until SF draws over it (same dance as desktop-off).
        if [ "$(getprop sys.boot_completed)" = "1" ]; then
            setsid sh -c '
                end=$(( $(date +%s) + 240 ))
                while [ "$(date +%s)" -lt "$end" ]; do
                    if [ "$(getprop init.svc.bootanim)" = "running" ]; then
                        setprop service.bootanim.exit 1
                        setprop service.bootanim.progress 1
                        sleep 3
                        [ "$(getprop init.svc.bootanim)" = "running" ] && stop bootanim
                    fi
                    sleep 1
                done
            ' </dev/null >/dev/null 2>&1 &
        fi
        lc_state_write RECOVERY "$generation" rollback failed || true
    fi
    lc_lock_release
}
trap rollback EXIT HUP INT TERM

# Prove the guest is running before Android releases display ownership.
lc_state_write ENTERING "$generation" guest running
"$DET/bin/guest-start" || { echo "guest-start failed"; exit 1; }
guest_state=$("$DET/lxc/bin/lxc-info" -P "$DET" -n guest -sH 2>/dev/null)
[ "$guest_state" = RUNNING ] || {
    echo "guest failed to reach RUNNING state (state=${guest_state:-unknown})"
    exit 1
}

# Grab input before Android's UI disappears.
"$DET/bin/evgrab" -a -p "$DET/run/evgrab.legacy.pid" || { echo "evgrab failed"; exit 1; }
evgrab_pid=$(sed -n 's/^pid=//p' "$DET/run/evgrab.legacy.pid" 2>/dev/null | head -n 1)
[ -n "$evgrab_pid" ] || evgrab_pid=$(sed -n '1p' "$DET/run/evgrab.legacy.pid" 2>/dev/null)
case "$evgrab_pid" in ''|*[!0-9]*) echo "evgrab identity unavailable"; exit 1;; esac
lc_pid_write evgrab "$evgrab_pid" "$generation" || { echo "evgrab identity unavailable"; exit 1; }
lc_state_write ENTERING "$generation" display-owner running

stop bootanim
stop surfaceflinger

# Keep SF stopped and restore the backlight it zeroes on every stop.
BL_LEVEL=$DET_BACKLIGHT_LEVEL
BL=$DET_BACKLIGHT_PATH
(
    while [ -f "$DET/run/desktop-mode" ]; do
        [ "$(getprop init.svc.surfaceflinger)" = "running" ] && {
            echo "suppressor: SF respawned, re-stopping ($(date))"
            stop surfaceflinger
        }
        [ -n "$BL" ] && echo "$BL_LEVEL" > "$BL" 2>/dev/null
        sleep 1
    done
) &
lc_pid_write suppressor "$!" "$generation" || exit 1

# Freeze system_server before its blocked display thread trips Watchdog.
# desktop-off must SIGKILL it; SIGCONT resumes with accumulated block time.
(
    while [ -f "$DET/run/desktop-mode" ]; do
        pid=$(pidof system_server 2>/dev/null)
        if [ -n "$pid" ]; then
            state=$(awk '/^State:/{print $2; exit}' /proc/$pid/status 2>/dev/null)
            if [ "$state" != "T" ] && [ "$state" != "t" ]; then
                kill -STOP "$pid" 2>/dev/null &&
                    echo "ss-freezer: STOPped system_server pid=$pid state=$state $(date)"
            fi
        fi
        sleep 0.2
    done
) &
lc_pid_write ss-freezer "$!" "$generation" || exit 1

i=0
while [ "$(getprop init.svc.surfaceflinger)" != "stopped" ]; do
    i=$((i+1)); [ $i -gt 20 ] && { echo "SF didn't stop"; exit 1; }
    sleep 0.5
done
# Let the vendor HAL drop SF's client state.
sleep 1

# SF zeroes the active backlight node; keep desktop brightness burn-in-safe.
[ -n "$BL" ] && echo "$BL_LEVEL" > "$BL" 2>/dev/null

# Run the bounded transition while neither SF nor phoc owns HWC.
lc_state_write ENTERING "$generation" animation running
"$DET/bin/run-transition" desktop ||
    echo "WARN: native desktop transition skipped/failed rc=$? (see log/transition.log)"

# Audio failure is non-fatal and remains journal-recoverable.
if [ -x "$DET/bin/det-audio-route" ] &&
   [ -f "$DET/etc/audio-owner.conf" ]; then
    lc_state_write ENTERING "$generation" audio running
    # Resolve an interrupted audio restore before claiming desktop audio.
    audio_phase=$(sed -n 's/^phase=//p' "$DET/run/audio-owner.state" 2>/dev/null | tail -n 1)
    case "$audio_phase" in
        restoring|restore-failed)
            echo "recovering stale direct-audio journal phase=$audio_phase"
            for audio_service in $(sed -n 's/^service=//p' "$DET/etc/audio-owner.conf"); do
                stop "$audio_service" 2>/dev/null || true
            done
            "$DET/bin/det-audio-owner" recover --apply ||
                echo "WARN: stale direct-audio journal recovery failed"
            ;;
    esac
    "$DET/bin/det-audio-route" claim ||
        echo "WARN: direct audio claim failed; desktop continues muted"
fi

# Resolve the session preference; refusals fall back to qualified phosh.
SESSION_RECORD=$("$DET/bin/session-select") || SESSION_RECORD=
[ -n "$SESSION_RECORD" ] || { echo "session-select produced no record"; exit 1; }
record_field() {
    printf '%s\n' "$SESSION_RECORD" | sed -n "s/^$1=//p" | head -n 1
}
sess_id=$(record_field id)
sess_compositor=$(record_field compositor)
sess_args=$(record_field compositor_args)
sess_shell=$(record_field shell)
sess_backend=$(record_field backend)
case "$sess_compositor" in /*) ;; *) echo "session compositor path invalid"; exit 1 ;; esac
umask 077
printf '%s\n' "$SESSION_RECORD" > "$DET/run/session.active.new.$$" &&
    mv -f "$DET/run/session.active.new.$$" "$DET/run/session.active"

# Raw-KMS sessions (KWin) own DRM directly and need the composer HAL gone.
if [ "$sess_backend" = gralloc-minigbm ]; then
    stop $HWC_SVC 2>/dev/null || true
    i=0
    while [ "$(getprop init.svc.$HWC_SVC)" != "stopped" ]; do
        i=$((i+1)); [ $i -gt 10 ] && { echo "composer HAL did not stop"; exit 1; }
        sleep 0.5
    done
    # sde_connector applies props.brightness at first frame; seed pre-commit.
    echo 500 > /sys/class/backlight/panel0-backlight/brightness 2>/dev/null || true
    # KWin treats the SDE writeback connector as a real second output.
    echo off > /sys/class/drm/card0-Virtual-1/status 2>/dev/null
fi

# Do not start phoc with -E: waitid(P_PIDFD) is broken on this 4.14 kernel.
# Transfer input only after proving system_server is frozen; wayland-0 is too late.
ss_pid=$(pidof system_server 2>/dev/null)
ss_state=
[ -z "$ss_pid" ] || ss_state=$(awk '/^State:/{print $2; exit}' "/proc/$ss_pid/status" 2>/dev/null)
case "$ss_state" in
    T|t)
        # Raw-KMS sessions open evdev while the grab is held and only receive
        # events once it drops --- release after their socket comes up instead.
        if [ "$sess_backend" != gralloc-minigbm ]; then
            lc_pid_signal evgrab TERM "$generation"
            rm -f "$DET/run/evgrab.legacy.pid"
        fi
        echo "input boundary handed to guest --- system_server frozen $(date)"
        ;;
    *)
        echo "system_server is not frozen at input handoff (pid=$ss_pid state=$ss_state)"
        exit 1
        ;;
esac

# The command-provider leaves one app_process worker per completed shell call.
# They have no display or guest role and can occupy gigabytes after a work session.
lc_state_write ENTERING "$generation" android-workers running
"$DET/bin/desktop-memory" reclaim "$generation" ||
    echo "WARN: stale command-worker reclaim failed; desktop continues"

CLOG="$DET/log/compositor.log"
: > "$CLOG"
lc_state_write ENTERING "$generation" compositor running
echo "selected session: $sess_id (compositor=$sess_compositor shell=${sess_shell:-none} backend=$sess_backend)"
if [ "$sess_backend" = gralloc-minigbm ]; then
# KWin path: systemd unit with a PAM/logind session (its DRM backend refuses
# devices without one); det-plasma-session owns Mesa env and client spawn.
(
    # Everything this loop does lands in CLOG, including its own early death.
    exec >> "$CLOG" 2>&1
    echo "=== compositor supervisor pid=$$ start $(date)"
    fails=0
    while [ -f "$DET/run/desktop-mode" ]; do
        echo "--- launch $sess_id (prior consecutive fast-fails: $fails) $(date)"
        t0=$(date +%s)
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            trap "echo env-prep: TERM-trap >> /tmp/envprep.log" TERM HUP INT
            tries=0
            until [ -s /run/det-plasma.env ]; do
                tries=$((tries+1))
                [ "$tries" -le 3 ] || { echo "env-prep: giving up"; break; }
                echo "env-prep: attempt $tries"
                [ -x /usr/local/sbin/det-input-udevdb ] && det-input-udevdb 2>/dev/null
                # KWin needs a udev DB entry for the DRM card or TakeDevice ENODEV.
                mkdir -p /run/udev/data
                for c in /sys/class/drm/card[0-9]; do
                    [ -e "$c/dev" ] || continue
                    printf "E:ID_SEAT=seat0\nG:seat\nG:master-of-seat\nQ:seat\nQ:master-of-seat\nI:1\n" \
                        > "/run/udev/data/c$(cat "$c/dev")"
                done
                systemctl start systemd-logind 2>/dev/null || true
                # Nightlight plugin segfaults under the Aug-9 patched libkwin
                # (ABI skew with system libKF6ConfigCore); keep it off.
                install -d -o melissa -g melissa -m 700 /home/melissa/.config
                grep -q nightlightEnabled /home/melissa/.config/kwinrc 2>/dev/null ||
                    printf "[Plugins]\nnightlightEnabled=false\n" \
                        > /home/melissa/.config/kwinrc
                chown melissa:melissa /home/melissa/.config/kwinrc 2>/dev/null || true
                case "$(basename "$1")" in
                    plasmashell|det-plasma-client) client=plasmashell ;;
                    *)                             client=foot ;;
                esac
                printf "DET_GRAPHICS_RENDERER=mesa\nDET_PLASMA_CLIENT=%s\n" "$client" \
                    > /run/det-plasma.env
                chmod 0644 /run/det-plasma.env
                sleep 1
            done
            echo "env-prep: done client=$client try=$tries"' \
            plasma-env "$sess_shell" >> "$CLOG" 2>&1
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            systemctl restart det-plasma.service || exit 10
            while systemctl is-active --quiet det-plasma.service; do sleep 1; done
            journalctl -u det-plasma.service -n 100 --no-pager 2>/dev/null || true
        ' >> "$CLOG" 2>&1
        rc=$?
        dur=$(( $(date +%s) - t0 ))
        [ -f "$DET/run/desktop-mode" ] || { echo "$sess_id exited rc=$rc after ${dur}s --- desktop mode off, stopping $(date)" >> "$CLOG"; break; }
        if [ "$dur" -lt 5 ]; then
            fails=$((fails+1))
            back=$fails; [ "$back" -gt 10 ] && back=10
            echo "FAST-FAIL: $sess_id died in ${dur}s rc=$rc (consecutive=$fails); backing off ${back}s $(date)" >> "$CLOG"
            sleep "$back"
        else
            echo "$sess_id exited rc=$rc after ${dur}s (ran long --- not a fast-fail); relaunching $(date)" >> "$CLOG"
            fails=0
            sleep 1
        fi
    done
) &
lc_pid_write compositor "$!" "$generation" || exit 1
else
(
    fails=0
    while [ -f "$DET/run/desktop-mode" ]; do
        echo "--- launch $sess_id (prior consecutive fast-fails: $fails) $(date)" >> "$CLOG"
        t0=$(date +%s)
        # Prepare root-owned input state before launching unprivileged compositor.
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            install -d -o melissa -g melissa -m 700 /run/user/1000
            # phoc segfaults instead of reporting an unreadable config.
            chmod a+r /etc/phoc.ini 2>/dev/null || true
            if [ -x /usr/local/sbin/det-input-udevdb ]; then
                det-input-udevdb 2>/dev/null && det-platform service-start seatd 2>/dev/null
            fi' >> "$CLOG" 2>&1
        # det-platform preserves melissa's android_input supplementary group.
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            exec det-platform run-user melissa \
                /usr/local/bin/det-session-launch compositor "$1" ${2:-}
        ' compositor-shim "$sess_compositor" "$sess_args" >> "$CLOG" 2>&1
        rc=$?
        dur=$(( $(date +%s) - t0 ))
        [ -f "$DET/run/desktop-mode" ] || { echo "$sess_id exited rc=$rc after ${dur}s --- desktop mode off, stopping $(date)" >> "$CLOG"; break; }
        if [ "$dur" -lt 5 ]; then
            fails=$((fails+1))
            back=$fails; [ "$back" -gt 10 ] && back=10
            echo "FAST-FAIL: $sess_id died in ${dur}s rc=$rc (consecutive=$fails); backing off ${back}s $(date)" >> "$CLOG"
            sleep "$back"
        else
            echo "$sess_id exited rc=$rc after ${dur}s (ran long --- not a fast-fail); relaunching $(date)" >> "$CLOG"
            fails=0
            sleep 1
        fi
    done
) &
fi
lc_pid_write compositor "$!" "$generation" || exit 1

# The pidfd shim is required for Phosh child watches on this kernel.
if [ "$sess_backend" != gralloc-minigbm ]; then
(
    case "${sess_shell##*/}" in
    phosh)
        # Qualified path: dedicated launcher, systemd user unit when present.
        while [ -f "$DET/run/desktop-mode" ]; do
            "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                # OpenRC stays on the direct launcher until elogind is qualified.
                if [ "$(det-platform init)" = systemd ] &&
                        [ -f /etc/systemd/system/det-phosh.service ]; then
                    systemctl stop det-phosh.service 2>/dev/null || true
                    det-platform service-start det-phosh || exit 10
                    while det-platform service-active det-phosh; do sleep 1; done
                    journalctl -u det-phosh.service -n 100 --no-pager 2>/dev/null || true
                    exit 11
                fi
                exec det-platform run-user melissa /usr/local/bin/det-phosh-session
            ' >> "$CLOG" 2>&1
            [ -f "$DET/run/desktop-mode" ] || break
            sleep 2
        done
        ;;
    *)
        # Generic shells: plain Wayland client; empty shell -> foot fallback.
        while [ -f "$DET/run/desktop-mode" ]; do
            "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c '
                export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
                exec det-platform run-user melissa \
                    /usr/local/bin/det-session-launch client "$1"
            ' client-shim "$sess_shell" >> "$CLOG" 2>&1
            [ -f "$DET/run/desktop-mode" ] || break
            sleep 2
        done
        ;;
    esac
) &
lc_pid_write client "$!" "$generation" || exit 1
fi

# DESKTOP commits only on a real Wayland socket, not just live launcher loops.
case "$sess_backend" in
gralloc-minigbm) GUEST_SOCKET=/run/user/1000/wayland-0 ;;
*)               GUEST_SOCKET=/run/user/1000/wayland-0 ;;
esac
i=0
until "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- \
        /usr/bin/test -S "$GUEST_SOCKET" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 150 ] || {
        echo "FATAL: $sess_id did not publish $GUEST_SOCKET; rolling back to phone mode"
        exit 1
    }
    sleep 0.2
done

# Raw-KMS compositors opened evdev under our grab; only now do events flow.
if [ "$sess_backend" = gralloc-minigbm ]; then
    lc_pid_signal evgrab TERM "$generation"
    rm -f "$DET/run/evgrab.legacy.pid"
    sleep 3
    # SF stop suspends the oplus touchpanel into gesture mode; kwin's raw-KMS
    # unblank cannot resume it (oplus atomic notifier compiled out). Manual fire.
    echo 1 > /sys/kernel/oplus_display/notify_panel_blank 2>/dev/null || true
fi
lc_state_write DESKTOP "$generation" session committed
trap - EXIT HUP INT TERM
lc_lock_release
if [ -x "$DET/bin/external-input" ]; then
    "$DET/bin/external-input" start >/dev/null 2>&1 ||
        echo "WARN: USB/Bluetooth peripheral bridge did not start"
fi
echo "desktop mode up ($sess_id session; log/compositor.log)"
