#!/system/bin/sh
# Generate guest-side configuration derived safely from the host display.

set -u
AURORA=${AURORA:-/data/aurora}
. "$AURORA/bin/device-config"
. "$AURORA/bin/lifecycle-lib"

GUEST_ROOT=${AURORA_GUEST_ROOT:-$(readlink -f "$AURORA/active-guest" 2>/dev/null)}
[ -n "$GUEST_ROOT" ] || GUEST_ROOT="$AURORA/guest"
GUEST_ETC="$GUEST_ROOT/etc"
[ -d "$GUEST_ROOT" ] || { echo "FATAL: guest rootfs missing: $GUEST_ROOT" >&2; exit 1; }
mkdir -p "$GUEST_ETC"

if [ "${AURORA_LOCK_HELD:-0}" != 1 ]; then
    lc_lock_acquire
    trap 'rm -f "$GUEST_ETC/phoc.ini.new.$$" "$GUEST_ETC/aurora-device.conf.new.$$"; lc_lock_release' EXIT HUP INT TERM
fi
umask 077
PHOC_TMP="$GUEST_ETC/phoc.ini.new.$$"
{
    echo '# Generated by Aurora; edit /data/aurora/etc/device.conf instead.'
    [ -n "$AURORA_PANEL_WIDTH" ] && echo "# Physical panel: ${AURORA_PANEL_WIDTH}x${AURORA_PANEL_HEIGHT}"
    echo "[output:$AURORA_HWC_OUTPUT]"
    echo "scale = $AURORA_OUTPUT_SCALE"
} > "$PHOC_TMP"
mv -f "$PHOC_TMP" "$GUEST_ETC/phoc.ini"
chmod 0644 "$GUEST_ETC/phoc.ini"

DEVICE_TMP="$GUEST_ETC/aurora-device.conf.new.$$"
{
    echo '# Generated by Aurora; consumed by guest-side helpers.'
    echo "AURORA_BATTERY_GAUGE=$AURORA_BATTERY_GAUGE"
    echo "AURORA_INPUT_QUIRK=$AURORA_INPUT_QUIRK"
    echo "AURORA_GRAPHICS_RENDERER=$AURORA_GRAPHICS_RENDERER"
    echo "AURORA_GBM_PROVIDER=$AURORA_GBM_PROVIDER"
    echo "AURORA_EXTERNAL_RENDERER=$AURORA_EXTERNAL_RENDERER"
    echo "AURORA_DRM_RENDER_NODE=$AURORA_DRM_RENDER_NODE"
    echo "AURORA_PANEL_WIDTH=$AURORA_PANEL_WIDTH"
    echo "AURORA_PANEL_HEIGHT=$AURORA_PANEL_HEIGHT"
    echo "AURORA_PANEL_REFRESH_MHZ=$AURORA_PANEL_REFRESH_MHZ"
} > "$DEVICE_TMP"
mv -f "$DEVICE_TMP" "$GUEST_ETC/aurora-device.conf"
chmod 0644 "$GUEST_ETC/aurora-device.conf"

echo "Generated guest display config: output=$AURORA_HWC_OUTPUT scale=$AURORA_OUTPUT_SCALE panel=${AURORA_PANEL_WIDTH:-unknown}x${AURORA_PANEL_HEIGHT:-unknown}"
