#!/system/bin/sh
# Shared device configuration for host-side Aurora scripts.
#
# Values are discovered conservatively at runtime, then overridden by a typed
# data file. Profiles are never sourced as shell code.

AURORA=${AURORA:-/data/aurora}

aurora_first_path() {
    for aurora_path in "$@"; do
        [ -e "$aurora_path" ] && { echo "$aurora_path"; return 0; }
    done
    return 1
}

aurora_first_netdev() {
    for aurora_path in /sys/class/net/wlan* /sys/class/net/wifi*; do
        [ -e "$aurora_path" ] && { basename "$aurora_path"; return 0; }
    done
    return 1
}

# Portable defaults. Discovery deliberately prefers the active Android-facing
# node names used by existing devices and falls back to the first viable node.
AURORA_BACKLIGHT_PATH=${AURORA_BACKLIGHT_PATH:-$(aurora_first_path \
    /sys/class/backlight/backlight/brightness \
    /sys/class/backlight/panel0-backlight/brightness \
    /sys/class/leds/lcd-backlight/brightness 2>/dev/null)}
AURORA_BACKLIGHT_LEVEL=${AURORA_BACKLIGHT_LEVEL:-}
AURORA_WIFI_IFACE=${AURORA_WIFI_IFACE:-$(aurora_first_netdev 2>/dev/null)}
AURORA_DRM_CARD=${AURORA_DRM_CARD:-/dev/dri/card0}
AURORA_DRM_RENDER_NODE=${AURORA_DRM_RENDER_NODE:-$(aurora_first_path \
    /dev/dri/renderD128 /dev/dri/card0 2>/dev/null)}
AURORA_BATTERY_GAUGE=${AURORA_BATTERY_GAUGE:-}
AURORA_EXTRA_DEVICES=${AURORA_EXTRA_DEVICES:-}
AURORA_INPUT_QUIRK=${AURORA_INPUT_QUIRK:-none}
AURORA_HWC_OUTPUT=${AURORA_HWC_OUTPUT:-HWCOMPOSER-1}
AURORA_GRAPHICS_RENDERER=${AURORA_GRAPHICS_RENDERER:-libhybris}
AURORA_GBM_PROVIDER=${AURORA_GBM_PROVIDER:-minigbm}
AURORA_EXTERNAL_RENDERER=${AURORA_EXTERNAL_RENDERER:-auto}
AURORA_PANEL_WIDTH=${AURORA_PANEL_WIDTH:-}
AURORA_PANEL_HEIGHT=${AURORA_PANEL_HEIGHT:-}
AURORA_PANEL_REFRESH_MHZ=${AURORA_PANEL_REFRESH_MHZ:-}
AURORA_OUTPUT_SCALE=${AURORA_OUTPUT_SCALE:-}

aurora_profile_bad() { echo "device-config: invalid $1" >&2; return 1; }
aurora_profile_word() { case "$2" in ''|*[!A-Za-z0-9._-]*) aurora_profile_bad "$1";; esac; }
aurora_profile_uint() { case "$2" in ''|*[!0-9]*) aurora_profile_bad "$1";; esac; }
aurora_profile_path() { case "$2" in /sys/*|/dev/*) case "$2" in *[!A-Za-z0-9._/-]*) aurora_profile_bad "$1";; esac;; *) aurora_profile_bad "$1";; esac; }

aurora_profile_set() {
    aurora_key=$1 aurora_value=$2
    case "$aurora_key" in
        AURORA_PROFILE_ID|AURORA_WIFI_IFACE|AURORA_BATTERY_GAUGE|AURORA_INPUT_QUIRK|AURORA_GRAPHICS_RENDERER|AURORA_GBM_PROVIDER|AURORA_EXTERNAL_RENDERER)
            aurora_profile_word "$aurora_key" "$aurora_value" || return 1 ;;
        AURORA_BACKLIGHT_LEVEL|AURORA_PANEL_WIDTH|AURORA_PANEL_HEIGHT|AURORA_PANEL_REFRESH_MHZ|AURORA_OUTPUT_SCALE)
            aurora_profile_uint "$aurora_key" "$aurora_value" || return 1 ;;
        AURORA_BACKLIGHT_PATH|AURORA_DRM_CARD|AURORA_DRM_RENDER_NODE)
            aurora_profile_path "$aurora_key" "$aurora_value" || return 1 ;;
        AURORA_HWC_OUTPUT)
            case "$aurora_value" in HWCOMPOSER-[0-9]) ;; *) aurora_profile_bad "$aurora_key"; return 1;; esac ;;
        AURORA_LINUX_FIRST_SUPPORTED|AURORA_LINUX_FIRST_KEEP_NETWORK|AURORA_LINUX_FIRST_FREEZE_SYSTEM_SERVER)
            case "$aurora_value" in 0|1) ;; *) aurora_profile_bad "$aurora_key"; return 1;; esac ;;
        AURORA_EXTRA_DEVICES)
            for aurora_extra in $aurora_value; do aurora_profile_path "$aurora_key" "$aurora_extra" || return 1; done ;;
        *) aurora_profile_bad "unknown key $aurora_key"; return 1 ;;
    esac
    export "$aurora_key=$aurora_value"
}

AURORA_LINUX_FIRST_SUPPORTED=${AURORA_LINUX_FIRST_SUPPORTED:-0}
AURORA_LINUX_FIRST_KEEP_NETWORK=${AURORA_LINUX_FIRST_KEEP_NETWORK:-1}
AURORA_LINUX_FIRST_FREEZE_SYSTEM_SERVER=${AURORA_LINUX_FIRST_FREEZE_SYSTEM_SERVER:-1}
AURORA_DEVICE_CONFIG="$AURORA/etc/device.conf"
if [ -r "$AURORA_DEVICE_CONFIG" ]; then
    while IFS= read -r aurora_line || [ -n "$aurora_line" ]; do
        case "$aurora_line" in ''|'#'*) continue;; *'='*)
            aurora_key=${aurora_line%%=*}; aurora_value=${aurora_line#*=}
            aurora_profile_set "$aurora_key" "$aurora_value" || return 1 ;;
        *) aurora_profile_bad "malformed line"; return 1;; esac
    done < "$AURORA_DEVICE_CONFIG"
fi

# Android reports the unrotated physical panel size. This is safe for UI
# scaling; cutouts and touch transforms are deliberately not inferred.
if [ -z "$AURORA_PANEL_WIDTH" ] || [ -z "$AURORA_PANEL_HEIGHT" ]; then
    aurora_wm_size=$(wm size 2>/dev/null | sed -n 's/.*Physical size: \([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' | head -n 1)
    [ -n "$aurora_wm_size" ] && {
        AURORA_PANEL_WIDTH=${aurora_wm_size%% *}
        AURORA_PANEL_HEIGHT=${aurora_wm_size#* }
    }
fi

# Aim for roughly 360 logical pixels across, matching common mobile shells.
if [ -z "$AURORA_OUTPUT_SCALE" ] && [ -n "$AURORA_PANEL_WIDTH" ]; then
    AURORA_OUTPUT_SCALE=$(((AURORA_PANEL_WIDTH + 180) / 360))
    [ "$AURORA_OUTPUT_SCALE" -lt 1 ] && AURORA_OUTPUT_SCALE=1
    [ "$AURORA_OUTPUT_SCALE" -gt 4 ] && AURORA_OUTPUT_SCALE=4
fi
AURORA_OUTPUT_SCALE=${AURORA_OUTPUT_SCALE:-1}

if [ -n "$AURORA_PANEL_REFRESH_MHZ" ] && {
        [ "$AURORA_PANEL_REFRESH_MHZ" -lt 24000 ] ||
        [ "$AURORA_PANEL_REFRESH_MHZ" -gt 240000 ]; }; then
    aurora_profile_bad AURORA_PANEL_REFRESH_MHZ
    return 1
fi

# Pick a usable brightness when a profile does not specify one: roughly one
# third of the panel maximum, never zero. Existing guacamoleb installs retain
# 1400 through their generated/profile config.
if [ -z "$AURORA_BACKLIGHT_LEVEL" ] && [ -n "$AURORA_BACKLIGHT_PATH" ]; then
    aurora_max=${AURORA_BACKLIGHT_PATH%/brightness}/max_brightness
    aurora_max=$(cat "$aurora_max" 2>/dev/null || echo 4095)
    AURORA_BACKLIGHT_LEVEL=$((aurora_max / 3))
    [ "$AURORA_BACKLIGHT_LEVEL" -gt 0 ] 2>/dev/null || AURORA_BACKLIGHT_LEVEL=1
fi

export AURORA_BACKLIGHT_PATH AURORA_BACKLIGHT_LEVEL AURORA_WIFI_IFACE
export AURORA_DRM_CARD AURORA_DRM_RENDER_NODE AURORA_BATTERY_GAUGE AURORA_EXTRA_DEVICES AURORA_INPUT_QUIRK
export AURORA_HWC_OUTPUT AURORA_PANEL_WIDTH AURORA_PANEL_HEIGHT AURORA_PANEL_REFRESH_MHZ AURORA_OUTPUT_SCALE
export AURORA_GRAPHICS_RENDERER AURORA_GBM_PROVIDER AURORA_EXTERNAL_RENDERER
export AURORA_LINUX_FIRST_SUPPORTED AURORA_LINUX_FIRST_KEEP_NETWORK AURORA_LINUX_FIRST_FREEZE_SYSTEM_SERVER
