#!/system/bin/sh
# Resolve $AURORA/etc/compositor + $AURORA/etc/sessions/<id>.session into KEY=value
# launch parameters. Planned/incompatible selections refuse and fall back to
# qualified phosh. Toybox-safe; testable via AURORA_SESSION_SELECT_ROOT.
set -u

ROOT=${AURORA_SESSION_SELECT_ROOT:-${AURORA:-/data/aurora}}

warn() { echo "session-select: $*" >&2; }

fallback_phosh() {
    phoc=$(resolve_any '/usr/local/bin/phoc|/usr/bin/phoc') || phoc=/usr/local/bin/phoc
    phosh=$(resolve_any '/usr/libexec/phosh|/usr/bin/phosh') || phosh=/usr/libexec/phosh
    [ -x "$GUEST$phoc" ] || warn "phosh fallback compositor is not installed: $phoc"
    echo "id=phosh"
    echo "qualification=qualified"
    echo "backend=libhybris-hwcomposer"
    echo "renderer=vendor-hybris"
    echo "compositor=$phoc"
    echo "compositor_args=-C /etc/phoc.ini"
    echo "shell=$phosh"
    echo "required_binaries=/usr/libexec/phosh|/usr/bin/phosh,/usr/bin/squeekboard"
    return 0
}

pref=$(cat "$ROOT/etc/compositor" 2>/dev/null || true)
case "$pref" in
    ''|*[!A-Za-z0-9-]*) pref=phosh ;;
esac

manifest="$ROOT/etc/sessions/$pref.session"
if [ ! -r "$manifest" ]; then
    [ "$pref" = phosh ] || warn "no manifest for '$pref'; using phosh"
    fallback_phosh
    exit 0
fi

manifest_field() {
    sed -n "s/^$1=//p" "$manifest" | head -n 1
}

GUEST="$ROOT/active-guest"
[ -d "$GUEST" ] || GUEST="$ROOT/guest"

# A field value is comma-separated items; an item may offer alternatives with
# '|'. Resolving to the path that exists on this guest keeps launch paths valid
# across distro layouts (Debian /usr/libexec, Arch /usr/bin).
resolve_any() {
    # Callers set IFS=, around required_binaries; split on spaces regardless.
    saved_ifs=$IFS
    IFS=' '
    for candidate in $(printf '%s' "$1" | tr '|' ' '); do
        case "$candidate" in
            /*) [ -x "$GUEST$candidate" ] && { IFS=$saved_ifs; echo "$candidate"; return 0; } ;;
        esac
    done
    IFS=$saved_ifs
    return 1
}

runtime_binary_ready() { resolve_any "$1" >/dev/null; }

qualification=$(manifest_field qualification)
case "$qualification" in
    qualified|proven|experimental|diagnostic) ;;
    planned|incompatible)
        warn "'$pref' is $qualification; refusing ($(manifest_field reason))"
        fallback_phosh
        exit 0
        ;;
    *)
        warn "'$pref' carries no usable qualification; refusing"
        fallback_phosh
        exit 0
        ;;
esac

compositor_field=$(manifest_field compositor)
case "$compositor_field" in
    /*) compositor=$(resolve_any "$compositor_field") || {
        warn "'$pref' compositor is not installed; using phosh"
        fallback_phosh
        exit 0
    } ;;
    *)
        warn "'$pref' has no absolute compositor path; refusing"
        fallback_phosh
        exit 0
        ;;
esac

shell_field=$(manifest_field shell)
shell=
case "$shell_field" in
    '') ;;
    hyprland-config) shell=$shell_field ;;
    /*) shell=$(resolve_any "$shell_field") || {
    warn "'$pref' shell is not installed; using phosh"
    fallback_phosh
    exit 0
    } ;;
    *)
    warn "'$pref' has no absolute shell path; refusing"
    fallback_phosh
    exit 0
    ;;
esac

required=$(manifest_field required_binaries)
saved_ifs=$IFS
IFS=,
for binary in $required; do
    if ! runtime_binary_ready "$binary"; then
        warn "'$pref' requires missing guest executable '$binary'; using phosh"
        IFS=$saved_ifs
        fallback_phosh
        exit 0
    fi
done
IFS=$saved_ifs

echo "id=$pref"
echo "qualification=$qualification"
echo "backend=$(manifest_field backend)"
echo "renderer=$(manifest_field renderer)"
echo "compositor=$compositor"
echo "compositor_args=$(manifest_field compositor_args)"
echo "shell=$shell"
exit 0
