#!/system/bin/sh
# Resolve $DET/etc/compositor + $DET/etc/sessions/<id>.session into KEY=value
# launch parameters. Planned/incompatible selections refuse and fall back to
# qualified phosh. Toybox-safe; testable via DET_SESSION_SELECT_ROOT.
set -u

ROOT=${DET_SESSION_SELECT_ROOT:-${DET:-/data/determination}}

warn() { echo "session-select: $*" >&2; }

fallback_phosh() {
    echo "id=phosh"
    echo "qualification=qualified"
    echo "backend=libhybris-hwcomposer"
    echo "renderer=vendor-hybris"
    echo "compositor=/usr/local/bin/phoc"
    echo "compositor_args=-C /etc/phoc.ini"
    echo "shell=/usr/local/bin/phosh"
    return 0
}

pref=$(cat "$ROOT/etc/compositor" 2>/dev/null || true)
case "$pref" in
    ''|*[!A-Za-z0-9-]*) pref=phosh ;;
esac

manifest="$ROOT/etc/sessions/$pref.session"
if [ ! -r "$manifest" ]; then
    [ "$pref" = phosh ] || warn "no manifest for '$pref'; using phosh"
    fallback_phosh
    exit 0
fi

manifest_field() {
    sed -n "s/^$1=//p" "$manifest" | head -n 1
}

qualification=$(manifest_field qualification)
case "$qualification" in
    qualified|proven|experimental|diagnostic) ;;
    planned|incompatible)
        warn "'$pref' is $qualification; refusing ($(manifest_field reason))"
        fallback_phosh
        exit 0
        ;;
    *)
        warn "'$pref' carries no usable qualification; refusing"
        fallback_phosh
        exit 0
        ;;
esac

compositor=$(manifest_field compositor)
case "$compositor" in
    /*) ;;
    *)
        warn "'$pref' has no absolute compositor path; refusing"
        fallback_phosh
        exit 0
        ;;
esac

echo "id=$pref"
echo "qualification=$qualification"
echo "backend=$(manifest_field backend)"
echo "renderer=$(manifest_field renderer)"
echo "compositor=$compositor"
echo "compositor_args=$(manifest_field compositor_args)"
echo "shell=$(manifest_field shell)"
exit 0
