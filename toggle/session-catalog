#!/system/bin/sh
set -eu
ROOT=${AURORA_SESSION_SELECT_ROOT:-${AURORA:-/data/aurora}}
GUEST="$ROOT/active-guest"
[ -d "$GUEST" ] || GUEST="$ROOT/guest"
for manifest in "$ROOT/etc/sessions/"*.session; do
    [ -f "$manifest" ] || continue
    id=${manifest##*/}; id=${id%.session}
    case "$id" in ''|*[!a-z0-9-]*) continue ;; esac
    echo "===$id"
    cat "$manifest"
    ready=yes
    reason=
    field() { sed -n "s/^$1=//p" "$manifest" | head -n 1; }
    compositor=$(field compositor)
    shell=$(field shell)
    required=$(field required_binaries)
    # An item may list alternatives ("/usr/libexec/phosh|/usr/bin/phosh"):
    # the same session has to be satisfiable on Debian, Arch, and Alpine.
    check_binary() {
        item=$1
        [ -n "$item" ] || return 0
        for binary in $(printf '%s' "$item" | tr '|' ' '); do
            case "$binary" in
                /*) [ -x "$GUEST$binary" ] && return 0 ;;
            esac
        done
        ready=no
        reason="Missing guest executable: $(printf '%s' "$item" | tr '|' '/')"
        return 1
    }
    check_binary "$compositor" || true
    if [ "$ready" = yes ] && [ "$shell" != hyprland-config ]; then
        check_binary "$shell" || true
    fi
    saved_ifs=$IFS
    IFS=,
    if [ "$ready" = yes ]; then
        for binary in $required; do
            check_binary "$binary" || break
        done
    fi
    IFS=$saved_ifs
    printf '\nruntime_ready=%s\nruntime_reason=%s\n' "$ready" "$reason"
done
