#!/system/bin/sh
# Concurrent external-display control. SurfaceFlinger and the phone panel stay live.
set -u

AURORA=/data/aurora
LXC="$AURORA/lxc/bin/lxc-attach -P $AURORA -n guest --"
HOST_SOCKET=/data/user_de/0/com.aurora.companion/files/presenter.sock
GUEST_SOCKET=/mnt/aurora-presenter/presenter.sock

status() {
    if [ -S "$HOST_SOCKET" ] &&
        grep -Fq "$HOST_SOCKET" /proc/net/unix 2>/dev/null; then
        socket=ready
    else
        socket=waiting
    fi
    if $AURORA/lxc/bin/lxc-info -P "$AURORA" -n guest 2>/dev/null | grep -q RUNNING; then
        guest=running
    else
        guest=stopped
    fi
    producer=$(cat "$AURORA/run/external-presenter.pid" 2>/dev/null || true)
    [ -n "$producer" ] && kill -0 "$producer" 2>/dev/null || producer=
    pool=$($LXC /bin/systemctl is-active aurora-gralloc-pool.service 2>/dev/null || true)
    plasma=$($LXC /bin/systemctl is-active aurora-plasma-presenter.service 2>/dev/null || true)
    echo "socket=$socket"
    echo "guest=$guest"
    echo "producer=${producer:-stopped}"
    echo "pool=${pool:-inactive}"
    echo "plasma=${plasma:-inactive}"
}

case "${1:-status}" in
    start)
        echo "Start the presenter from the Aurora app." >&2
        echo "Android correctly blocks shell-starting its non-exported service." >&2
        exit 2
        ;;
    smoke)
        "$AURORA/bin/guest-start" >/dev/null 2>&1 || exit 1
        i=0
        while [ ! -S "$HOST_SOCKET" ] && [ "$i" -lt 50 ]; do
            i=$((i + 1)); sleep 0.2
        done
        [ -S "$HOST_SOCKET" ] || {
            echo "FATAL: no DP presentation socket; connect a DP display" >&2
            exit 2
        }
        $LXC /usr/bin/test -S "$GUEST_SOCKET" || {
            echo "FATAL: presenter mount is absent; restart the guest once" >&2
            exit 3
        }
        $LXC /usr/bin/test -x /usr/local/bin/hybris-minigbm-probe || {
            echo "FATAL: guest presenter producer is not built" >&2
            exit 4
        }
        echo $$ > "$AURORA/run/external-presenter.pid"
        trap 'rm -f "$AURORA/run/external-presenter.pid"' EXIT INT TERM
        $LXC /bin/sh -c '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            export LD_LIBRARY_PATH=/usr/local/lib:/opt/minigbm/lib
            export HYBRIS_LD_LIBRARY_PATH=/usr/lib/android:/vendor/lib64:/system/lib64:/odm/lib64:/apex/com.android.runtime/lib64/bionic
            export ANDROID_ROOT=/system EGL_PLATFORM=null HYBRIS_EGLPLATFORM=null
            exec /usr/local/bin/hybris-minigbm-probe /dev/dri/renderD128 --present /mnt/aurora-presenter/presenter.sock 1920 1080 20
        '
        rm -f "$AURORA/run/external-presenter.pid"
        trap - EXIT INT TERM
        ;;
    plasma)
        "$AURORA/bin/guest-start" >/dev/null 2>&1 || exit 1
        i=0
        while { [ ! -S "$HOST_SOCKET" ] ||
            ! grep -Fq "$HOST_SOCKET" /proc/net/unix 2>/dev/null; }; do
            i=$((i + 1))
            [ "$i" -lt 50 ] || break
            sleep 0.1
        done
        [ -S "$HOST_SOCKET" ] &&
            grep -Fq "$HOST_SOCKET" /proc/net/unix 2>/dev/null || {
            echo "FATAL: start the DP presenter in the app and connect a display" >&2
            exit 2
        }
        $LXC /usr/bin/test -S "$GUEST_SOCKET" || {
            echo "FATAL: presenter mount is absent; restart the guest once" >&2
            exit 3
        }
        $LXC /usr/bin/test -x /usr/local/bin/aurora-gralloc-pool || {
            echo "FATAL: aurora-gralloc-pool is not installed" >&2
            exit 4
        }
        # A recreated Android display replaces presenter.sock.  Never leave a
        # KWin instance attached to the old broker/buffer pool: it remains
        # superficially active but can only present stale or black frames.
        input_active=$($AURORA/bin/external-input status 2>/dev/null || true)
        [ "$input_active" != active ] || \
            $AURORA/bin/external-input stop >/dev/null 2>&1 || true
        $LXC /bin/systemctl stop aurora-plasma-presenter.service \
            aurora-gralloc-pool.service 2>/dev/null || true
        $LXC /bin/systemctl reset-failed aurora-plasma-presenter.service \
            aurora-gralloc-pool.service 2>/dev/null || true
        $LXC /bin/systemctl start aurora-gralloc-pool.service || exit 5
        i=0
        while ! $LXC /usr/bin/test -S \
            /run/aurora/gralloc-pool.sock 2>/dev/null; do
            i=$((i + 1))
            [ "$i" -lt 50 ] || {
                echo "FATAL: gralloc pool did not become ready" >&2
                exit 6
            }
            sleep 0.1
        done
        $LXC /bin/systemctl start aurora-plasma-presenter.service || exit 7
        [ "$input_active" != active ] || \
            $AURORA/bin/external-input start >/dev/null 2>&1 || true
        echo "Full Plasma Desktop streaming to DP through gralloc dma-bufs"
        ;;
    stop)
        "$AURORA/bin/external-input" stop >/dev/null 2>&1 || true
        pid=$(cat "$AURORA/run/external-presenter.pid" 2>/dev/null || true)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
        rm -f "$AURORA/run/external-presenter.pid"
        $LXC /bin/systemctl stop aurora-plasma-presenter.service \
            aurora-gralloc-pool.service 2>/dev/null || true
        echo "Producer stopped; stop the Android presenter from the app." >&2
        ;;
    status) status ;;
    *) echo "usage: external-presenter start|status|smoke|plasma|stop" >&2; exit 2 ;;
esac
