#!/system/bin/sh
# Dock auto-summon (§8.3): enter desktop mode when a configured trigger
# appears, optionally return to phone when it goes away. Off by default.

set -u
DET=${DET:-/data/determination}
LOG=$DET/log/dock-watch.log
CONF=$DET/etc/dock.conf

[ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 131072 ] &&
    tail -c 65536 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
exec >>"$LOG" 2>&1
echo "--- dock-watch $(date)"

[ -f "$CONF" ] || { echo "no $CONF; exiting"; exit 0; }
. "$CONF"
case "${trigger:-off}" in
    charger|display) ;;
    *) echo "trigger=${trigger:-off} disabled; exiting"; exit 0 ;;
esac

poll="${poll_sec:-3}"
grace="${grace_sec:-10}"
exit_grace="${exit_grace_sec:-20}"
minbatt="${min_battery:-15}"

display_connected() {
    # Anything reported connected except the built-in panel and writeback.
    grep -H . /sys/class/drm/card*-*/status 2>/dev/null |
        grep -v 'eDP\|writeback' | grep -qw connected
}

charger_connected() {
    [ "$(cat /sys/class/power_supply/usb/online 2>/dev/null || echo 0)" = "1" ]
}

signal() {
    case "${trigger:-off}" in
        charger) charger_connected ;;
        display) display_connected ;;
        *) return 1 ;;
    esac
}

busy_transition() {
    sed -n 's/^state=//p' "$DET/run/transition.state" 2>/dev/null |
        grep -qE 'ENTERING|EXITING'
}

attaches=0 detaches=0 fired=0
while :; do
    sleep "$poll"
    if signal; then
        detaches=0
        attaches=$((attaches + 1))
        need=$((grace / poll + 1))
        if [ "$fired" = 0 ] && [ "$attaches" -ge "$need" ]; then
            attaches=0
            [ -f "$DET/run/desktop-mode" ] && continue
            busy_transition && { echo "skip: transition in flight"; continue; }
            batt=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 100)
            [ "$batt" -lt "$minbatt" ] && { echo "skip: battery ${batt}% < ${minbatt}%"; continue; }
            echo "dock trigger '${trigger}' stable ${grace}s; entering desktop $(date)"
            : > "$DET/run/dock-watch.fired"
            setsid sh -c "nohup $DET/bin/desktop-on >/dev/null 2>&1 &" >/dev/null 2>&1
            fired=1
        fi
    else
        attaches=0
        if [ "$fired" = 1 ] || [ -f "$DET/run/dock-watch.fired" ]; then
            detaches=$((detaches + 1))
            need=$((exit_grace / poll + 1))
            if [ "$detaches" -ge "$need" ]; then
                rm -f "$DET/run/dock-watch.fired"
                fired=0
                if [ "${auto_exit:-0}" = "1" ] && [ -f "$DET/run/desktop-mode" ]; then
                    echo "dock gone ${exit_grace}s; returning to phone $(date)"
                    setsid sh -c "nohup $DET/bin/desktop-off >/dev/null 2>&1 &" \
                        >/dev/null 2>&1
                fi
            fi
        fi
    fi
done
