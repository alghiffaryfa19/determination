#!/system/bin/sh
# Start the guest headless so desktop-on only performs ownership handoff.

set -u
AURORA=/data/aurora
LXC="$AURORA/lxc/bin"
export PATH="$LXC:$PATH"
. "$AURORA/bin/device-config"

# Preserve Debian's legacy path while selecting independent guest slots.
if [ -x "$AURORA/bin/guest-distro" ]; then
    "$AURORA/bin/guest-distro" ensure || exit 1
elif [ ! -L "$AURORA/active-guest" ]; then
    ln -s guest "$AURORA/active-guest.new" && mv -f "$AURORA/active-guest.new" "$AURORA/active-guest"
fi
GUEST_ROOT=$(readlink -f "$AURORA/active-guest" 2>/dev/null)
[ -n "$GUEST_ROOT" ] && [ -d "$GUEST_ROOT" ] || {
    echo "FATAL: selected guest rootfs is missing: $AURORA/active-guest" >&2
    exit 1
}
export AURORA_GUEST_ROOT="$GUEST_ROOT"

# Normalize legacy and imported rootfs images to the project-owned account
# before copying units that reference it. Never rename an account in a running
# guest. uid 1000 is part of the device-node contract, so preserve the numeric
# identity while replacing the login name.
if ! lxc-info -P "$AURORA" -n guest 2>/dev/null | grep -q RUNNING; then
    current_guest_user=$(awk -F: '$3 == 1000 { print $1; exit }' "$GUEST_ROOT/etc/passwd" 2>/dev/null)
    if [ -n "$current_guest_user" ] && [ "$current_guest_user" != aurora ]; then
        chroot "$GUEST_ROOT" /bin/sh -ec '
            export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            old_user=$1
            old_group=$(id -gn "$old_user")
            usermod -l aurora -d /home/aurora -m "$old_user"
            if [ "$old_group" != aurora ] && ! getent group aurora >/dev/null 2>&1; then
                groupmod -n aurora "$old_group"
            fi
        ' sh "$current_guest_user" || {
            echo "FATAL: could not normalize the uid-1000 guest account" >&2
            exit 1
        }
    fi
    if grep -q '^aurora:' "$GUEST_ROOT/etc/passwd" 2>/dev/null; then
        mkdir -p "$GUEST_ROOT/etc/sudoers.d"
        printf '%s\n' 'aurora ALL=(ALL) ALL' > "$GUEST_ROOT/etc/sudoers.d/aurora"
        chmod 0440 "$GUEST_ROOT/etc/sudoers.d/aurora"
        ssh_config="$GUEST_ROOT/etc/ssh/sshd_config.d/50-aurora.conf"
        if [ -f "$ssh_config" ]; then
            sed -i 's/^AllowUsers .*/AllowUsers aurora/' "$ssh_config"
        fi
    fi
fi

# Keep SSH host identity outside replaceable guest slots.
SSH_IDENTITY="$AURORA/etc/ssh-host-keys"
if [ ! -f "$SSH_IDENTITY/ssh_host_ed25519_key" ]; then
    for ssh_source in "$AURORA/guest/etc/ssh" "$GUEST_ROOT/etc/ssh"; do
        [ -f "$ssh_source/ssh_host_ed25519_key" ] || continue
        install -d -m 0700 "$SSH_IDENTITY"
        for ssh_key in "$ssh_source"/ssh_host_*_key "$ssh_source"/ssh_host_*_key.pub; do
            [ -f "$ssh_key" ] || continue
            cp -f "$ssh_key" "$SSH_IDENTITY/${ssh_key##*/}"
        done
        chmod 0600 "$SSH_IDENTITY"/ssh_host_*_key
        chmod 0644 "$SSH_IDENTITY"/ssh_host_*_key.pub
        break
    done
fi
if [ -f "$SSH_IDENTITY/ssh_host_ed25519_key" ] && [ -d "$GUEST_ROOT/etc/ssh" ]; then
    for ssh_key in "$SSH_IDENTITY"/ssh_host_*_key "$SSH_IDENTITY"/ssh_host_*_key.pub; do
        [ -f "$ssh_key" ] || continue
        cp -f "$ssh_key" "$GUEST_ROOT/etc/ssh/${ssh_key##*/}"
    done
    chmod 0600 "$GUEST_ROOT"/etc/ssh/ssh_host_*_key
    chmod 0644 "$GUEST_ROOT"/etc/ssh/ssh_host_*_key.pub
fi

mkdir -p "$AURORA/lxc/lib/lxc/rootfs" "$AURORA/run" "$AURORA/run/control" "$AURORA/log"

# Regenerate device binds after possible Android OTA changes.
"$AURORA/bin/generate-lxc-config" || { echo "FATAL: LXC config generation failed"; exit 1; }
"$AURORA/bin/generate-guest-config" || { echo "FATAL: guest config generation failed"; exit 1; }

# Remove only the obsolete compatibility symlink, never a real directory.
[ -L /data/decemberos ] && rm -f /data/decemberos
# LXC resolves the named container through $AURORA/guest/config.
mkdir -p "$AURORA/guest"
cp -f "$AURORA/lxc/config" "$AURORA/guest/config"

# Refresh distro-neutral static guest tools before every start.
for aurora_guest_tool in aurora-guest-agent aurora-audio-probe aurora-audio-session aurora-audio-volume aurora-pipewire-smoke \
                      aurora-input-actions aurora-media-action aurora-connectivity aurora-connectivity-menu \
                      aurora-platform aurora-apps aurora-phosh-session aurora-compat-check aurora-osk \
                      aurora-firefox-content-defaults aurora-session-launch aurora-hyprland \
                      aurora-plasma-session aurora-plasma-client aurora-hyprland-opal \
                      aurora-hyprland-omarchy aurora-omarchy aurora-opal opal \
                      aurora-input-proxy aurora-input-proxy-session; do
    if [ -f "$AURORA/guest-tools/$aurora_guest_tool" ]; then
        mkdir -p "$GUEST_ROOT/usr/local/bin"
        cp -f "$AURORA/guest-tools/$aurora_guest_tool" \
            "$GUEST_ROOT/usr/local/bin/$aurora_guest_tool"
        chmod 0755 "$GUEST_ROOT/usr/local/bin/$aurora_guest_tool"
    fi
done
if [ -d "$AURORA/guest-assets/opal" ]; then
    mkdir -p "$GUEST_ROOT/usr/local/share/aurora-opal"
    cp -a "$AURORA/guest-assets/opal/." "$GUEST_ROOT/usr/local/share/aurora-opal/"
fi
if [ -d "$AURORA/guest-assets/omarchy" ]; then
    mkdir -p "$GUEST_ROOT/usr/local/share/aurora-omarchy"
    cp -a "$AURORA/guest-assets/omarchy/." "$GUEST_ROOT/usr/local/share/aurora-omarchy/"
    # Early module zips stored every entry as 0644. Restore the executable bit
    # on the vendored Omarchy shebang scripts at every start so a stale payload
    # repairs itself instead of shipping broken commands.
    find "$GUEST_ROOT/usr/local/share/aurora-omarchy" -type f 2>/dev/null | while IFS= read -r f; do
        [ "$(dd if="$f" bs=2 count=1 2>/dev/null)" = '#!' ] || continue
        chmod 0755 "$f"
    done
fi
for aurora_guest_config in "$AURORA"/guest-config/*.conf; do
    [ -f "$aurora_guest_config" ] || continue
    mkdir -p "$GUEST_ROOT/etc/aurora"
    cp -f "$aurora_guest_config" "$GUEST_ROOT/etc/aurora/$(basename "$aurora_guest_config")"
    chmod 0644 "$GUEST_ROOT/etc/aurora/$(basename "$aurora_guest_config")"
done
if [ -f "$AURORA/guest-tools/setup-compatibility.sh" ]; then
    mkdir -p "$GUEST_ROOT/usr/local/sbin"
    cp -f "$AURORA/guest-tools/setup-compatibility.sh" \
        "$GUEST_ROOT/usr/local/sbin/setup-compatibility.sh"
    chmod 0755 "$GUEST_ROOT/usr/local/sbin/setup-compatibility.sh"
fi
if [ -f "$AURORA/guest-tools/aurora-phosh.service" ]; then
    mkdir -p "$GUEST_ROOT/usr/local/lib/aurora"
    cp -f "$AURORA/guest-tools/aurora-phosh.service" \
        "$GUEST_ROOT/usr/local/lib/aurora/aurora-phosh.service"
    chmod 0644 "$GUEST_ROOT/usr/local/lib/aurora/aurora-phosh.service"
    if [ -d "$GUEST_ROOT/etc/systemd/system" ]; then
        cp -f "$AURORA/guest-tools/aurora-phosh.service" \
            "$GUEST_ROOT/etc/systemd/system/aurora-phosh.service"
        chmod 0644 "$GUEST_ROOT/etc/systemd/system/aurora-phosh.service"
    fi
fi
if [ -f "$AURORA/guest-tools/aurora-plasma.service" ] && [ -d "$GUEST_ROOT/etc/systemd/system" ]; then
    cp -f "$AURORA/guest-tools/aurora-plasma.service" \
        "$GUEST_ROOT/etc/systemd/system/aurora-plasma.service"
    chmod 0644 "$GUEST_ROOT/etc/systemd/system/aurora-plasma.service"
fi
if [ -f "$AURORA/guest-tools/aurora-input-proxy.service" ] && [ -d "$GUEST_ROOT/etc/systemd/system" ]; then
    cp -f "$AURORA/guest-tools/aurora-input-proxy.service" \
        "$GUEST_ROOT/etc/systemd/system/aurora-input-proxy.service"
    chmod 0644 "$GUEST_ROOT/etc/systemd/system/aurora-input-proxy.service"
    mkdir -p "$GUEST_ROOT/etc/systemd/system/multi-user.target.wants"
    ln -sf ../aurora-input-proxy.service \
        "$GUEST_ROOT/etc/systemd/system/multi-user.target.wants/aurora-input-proxy.service"
fi
if [ -f "$AURORA/guest-tools/aurora-input-udevdb" ]; then
    mkdir -p "$GUEST_ROOT/usr/local/sbin"
    cp -f "$AURORA/guest-tools/aurora-input-udevdb" "$GUEST_ROOT/usr/local/sbin/aurora-input-udevdb"
    chmod 0755 "$GUEST_ROOT/usr/local/sbin/aurora-input-udevdb"
fi
if [ -f "$AURORA/guest-tools/aurora-connectivity.desktop" ]; then
    mkdir -p "$GUEST_ROOT/usr/share/applications"
    cp -f "$AURORA/guest-tools/aurora-connectivity.desktop" \
        "$GUEST_ROOT/usr/share/applications/aurora-connectivity.desktop"
    chmod 0644 "$GUEST_ROOT/usr/share/applications/aurora-connectivity.desktop"
fi
if [ "${AURORA_PROFILE_ID:-}" = guacamoleb ] && \
   [ -f "$AURORA/guest-tools/90-aurora-direct.conf" ]; then
    mkdir -p "$GUEST_ROOT/etc/pipewire/pipewire.conf.d"
    cp -f "$AURORA/guest-tools/90-aurora-direct.conf" \
        "$GUEST_ROOT/etc/pipewire/pipewire.conf.d/90-aurora-direct.conf"
    chmod 0644 "$GUEST_ROOT/etc/pipewire/pipewire.conf.d/90-aurora-direct.conf"
fi

# Override Android /data's nodev and nosuid flags for the guest bind mount.
if ! grep -q " $GUEST_ROOT " /proc/mounts; then
    mount --bind "$GUEST_ROOT" "$GUEST_ROOT"
    mount -o remount,bind,dev,exec,suid "$GUEST_ROOT" "$GUEST_ROOT"
fi

# netd periodically rebuilds routing state, so every rule must be re-assertable.
net_assert() {
    ip link add aurora0 type bridge 2>/dev/null
    ip addr add 192.168.117.1/24 dev aurora0 2>/dev/null
    ip link set aurora0 up
    echo 1 > /proc/sys/net/ipv4/ip_forward

    iptables -t nat -C POSTROUTING -s 192.168.117.0/24 -j MASQUERADE 2>/dev/null ||
        iptables -t nat -A POSTROUTING -s 192.168.117.0/24 -j MASQUERADE
    # Guest accepts must precede Android's netd chains.
    iptables -C INPUT -i aurora0 -j ACCEPT 2>/dev/null ||
        iptables -I INPUT 1 -i aurora0 -j ACCEPT
    iptables -C OUTPUT -o aurora0 -j ACCEPT 2>/dev/null ||
        iptables -I OUTPUT 1 -o aurora0 -j ACCEPT
    iptables -C FORWARD -s 192.168.117.0/24 -j ACCEPT 2>/dev/null ||
        iptables -I FORWARD 1 -s 192.168.117.0/24 -j ACCEPT
    iptables -C FORWARD -d 192.168.117.0/24 -j ACCEPT 2>/dev/null ||
        iptables -I FORWARD 1 -d 192.168.117.0/24 -j ACCEPT

    # Android policy routing ends unreachable without an explicit guest route.
    ip rule list | grep -q "to 192.168.117.0/24 lookup main" ||
        ip rule add pref 9000 to 192.168.117.0/24 lookup main
    # Match pref+iif because ip rule displays the numeric table ID.
    [ -n "$AURORA_WIFI_IFACE" ] && {
        ip rule list | grep -q "^21000:.*iif aurora0" ||
            ip rule add pref 21000 iif aurora0 lookup "$AURORA_WIFI_IFACE" 2>/dev/null
    }

    # Keep table 117 as fallback when netd deletes its Wi-Fi table.
    GW=$(ip route get 1.1.1.1 2>/dev/null | sed -n "s/.* via \([0-9.]*\) dev $AURORA_WIFI_IFACE .*/\1/p")
    [ -n "$GW" ] && ip route replace default via "$GW" dev "$AURORA_WIFI_IFACE" table 117 2>/dev/null
    ip rule list | grep -q "^21100:.*iif aurora0" ||
        ip rule add pref 21100 iif aurora0 lookup 117 2>/dev/null
}
net_assert

# Keep routing alive across netd rebuilds; never force Wi-Fi in phone mode.
if ! kill -0 "$(cat "$AURORA/run/net-keeper.pid" 2>/dev/null)" 2>/dev/null; then
    (
        fails=0
        while :; do
            net_assert 2>/dev/null
            if [ -f "$AURORA/run/desktop-mode" ]; then
                if [ -z "$AURORA_WIFI_IFACE" ] || [ "$(cat "/sys/class/net/$AURORA_WIFI_IFACE/operstate" 2>/dev/null)" = "up" ]; then
                    fails=0
                else
                    fails=$((fails+1))
                    linux_first=$(sed -n 's/^desired=//p' "$AURORA/state/boot-profile" 2>/dev/null | tail -n 1)
                    if [ "$linux_first" != linux-first ] && { [ "$fails" -eq 3 ] || [ $((fails % 9)) -eq 0 ]; }; then
                        echo "$AURORA_WIFI_IFACE not up x$fails --- svc wifi enable ($(date))" >> "$AURORA/log/net-keeper.log"
                        timeout 15 svc wifi enable </dev/null >/dev/null 2>&1
                    fi
                fi
                sleep 10
            else
                fails=0
                sleep 20
            fi
        done
    ) &
    echo $! > "$AURORA/run/net-keeper.pid"
fi

[ "$(stat -c %s "$AURORA/log/lxc.log" 2>/dev/null || echo 0)" -gt 262144 ] &&
    tail -c 131072 "$AURORA/log/lxc.log" > "$AURORA/log/lxc.log.tmp" &&
    mv "$AURORA/log/lxc.log.tmp" "$AURORA/log/lxc.log"

if ! lxc-info -P "$AURORA" -n guest 2>/dev/null | grep -q RUNNING; then
    lxc-start -P "$AURORA" -n guest -f "$AURORA/lxc/config" -l WARN -o "$AURORA/log/lxc.log"
    i=0
    until lxc-info -P "$AURORA" -n guest 2>/dev/null | grep -q RUNNING; do
        i=$((i+1)); [ $i -gt 20 ] && exit 1; sleep 0.5
    done
fi

# Fix flags inside the pivoted root; the host bind remount does not propagate.
# ashmem is boot-ID-named, devpts lacks usable ptmx, and seatd requires VT nodes.
BOOTID=$(cat /proc/sys/kernel/random/boot_id)
lxc-attach -P "$AURORA" -n guest -- /bin/sh -c \
    "mount -o remount,bind,suid,dev,exec / 2>/dev/null; \
     [ -e /dev/ashmem$BOOTID ] || { mknod /dev/ashmem$BOOTID c 10 59 && chmod 666 /dev/ashmem$BOOTID; }; \
     mount -o remount,gid=5,mode=620,ptmxmode=666 devpts /dev/pts 2>/dev/null; \
     [ -e /dev/ptmx ] || ln -sf pts/ptmx /dev/ptmx; \
     for n in 0 1 2; do [ -e /dev/tty\$n ] || mknod -m 620 /dev/tty\$n c 4 \$n; done" \
    2>/dev/null

# Set ping_group_range through the host because guest procfs is read-only.
GUEST_INIT=$(lxc-info -P "$AURORA" -n guest -pH 2>/dev/null)
if [ -n "$GUEST_INIT" ] && command -v nsenter >/dev/null 2>&1; then
    nsenter -t "$GUEST_INIT" -n -- sh -c \
        "echo '0 2147483647' > /proc/sys/net/ipv4/ping_group_range" ||
        echo "WARN: could not enable unprivileged ping in guest netns"
fi

# The host agent must outlive desktop toggles.
if [ -x "$AURORA/bin/aurora-hostagent" ]; then
    "$AURORA/bin/aurora-hostagent" &
fi
