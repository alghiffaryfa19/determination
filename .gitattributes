* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.img binary
*.zip binary
*.gz binary
*.apk binary
*.so binary

# Generated packages and device captures require an explicit retention record.
artifacts/** -text

# Captured terminal output, patch context, and upstream source retain their
# original whitespace; do not treat it as project formatting drift.
artifacts/aurorahyprland-*.txt -whitespace
artifacts/opal-deployed.txt -whitespace
graphics/aurorahyprland/patches/*.patch -whitespace
guest/quickshell-vendor-egl.patch -whitespace
guest/vendor/** -whitespace
