{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.invalid/schemas/update-manifest-v1.json",
  "title": "Aurora online update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "versionCode", "artifacts"],
  "properties": {
    "schema": { "const": 2 },
    "version": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 1 },
    "codename": { "type": "string" },
    "channel": { "type": "string" },
    "publishedAt": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "url", "sha256", "size"],
        "properties": {
          "type": { "enum": ["module", "runtime", "rootfs", "boot", "companion"] },
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
          "devices": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "abis": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "androidBuilds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "distro": { "enum": ["debian", "arch", "alpine"] },
          "support": { "enum": ["qualified", "experimental"] },
          "description": { "type": "string", "maxLength": 240 }
        }
      }
    }
  }
}
