#!/bin/sh
# det - Determination host helper. Wraps the wireless-adb dance so nothing else
# has to remember it. Uses official platform-tools if present (distro adb has
# broken pairing), and never runs `adb root` (drops wireless transports).
#
#   det find              discover the phone's current wireless port (mdns)
#   det connect           discover + connect
#   det shell [cmd...]    root shell (Magisk su) on the phone
#   det guest [cmd...]    shell inside the LXC guest AS melissa (bash -l if no cmd)
#   det guest-root [cmd]  root shell inside the guest (admin escape hatch)
#   det distro CMD        list/status/install/select/provision/qualify rootfs slots
#   det power MODE        sip/balanced/performance CPU+GPU profile (status too)
#   det passwd            set melissa's guest password (needed before sudo works)
#   det ssh-setup [key]   install sshd + authorize key (default: dedicated key)
#   det motd-setup        install/refresh the guest login MOTD
#   det ssh-route         route the guest subnet directly through the phone
#   det ssh [command...]  direct SSH to melissa@192.168.117.2
#   det on | det off      enter / leave desktop mode (detached; panel changes!)
#   det linux-first CMD   status, enable, disable, or apply the boot profile
#   det compat CMD        setup or inspect the application compatibility layer
#   det log [name] [n]    tail a /data/determination/log file (default toggle)
#   det vol up|down|set N%|mute|unmute|get   guest session audio volume
#   det notify TITLE [TEXT]  post an Android notification on the phone
#   det shot [out.png]    screenshot the Linux desktop to the host
#   det cast [port]       stream the desktop to VNC client or a browser tab
#   det open URL          open a URL in the guest browser session
#   det app CMD...        launch a GUI app detached in the guest session
#   det drop FILE...      beam files into the guest's ~/Incoming
#   det fetch PATH [DEST] pull a file out of the guest home dir
#   det stats [--watch N] battery/CPU/GPU/RAM live dashboard
#   det snap list|create|restore|rm   full-rootfs snapshots (time machine)
#   det version           print the local project version and release state
#   det status            connection, root, kernel, mode, guest state
#   det status --json     same data, machine-readable
#   det doctor            offline sanity check of host-side setup
#   det completions SHELL emit bash|zsh completion script (eval in rc)
#   det recon             run the §9 recon
#   det hybrid-probe      build/run the libhybris + gralloc + minigbm gate
#   det hybrid-bench      benchmark that shared-buffer path without display use
#   det push-module       install/refresh the Magisk module zip on the phone
#   det publish           push dist/usb-payload/ to the phone's USB drive
#                         (falls back to /sdcard/Determination if no drive)
#   det migrate           one-shot /data/decemberos -> /data/determination move
#                         (run once when upgrading a DecemberOS-era device)

set -eu
# Resolve symlinks before changing directory. This keeps `det` usable through
# /usr/local/bin/det or ~/.local/bin/det instead of looking for release files
# beside the symlink itself.
DET_SOURCE=$0
while [ -L "$DET_SOURCE" ]; do
    DET_SOURCE_DIR=$(CDPATH= cd -P "$(dirname "$DET_SOURCE")" && pwd)
    DET_LINK=$(readlink "$DET_SOURCE")
    case "$DET_LINK" in
        /*) DET_SOURCE=$DET_LINK ;;
        *) DET_SOURCE=$DET_SOURCE_DIR/$DET_LINK ;;
    esac
done
DET_SOURCE_DIR=$(CDPATH= cd -P "$(dirname "$DET_SOURCE")" && pwd)
cd "$DET_SOURCE_DIR"
SELF=$DET_SOURCE_DIR/$(basename "$DET_SOURCE")
. release/version.sh
det_load_version version.properties

for pt in "$HOME"/platform-tools /tmp/claude-*/-home-melissa/*/scratchpad/platform-tools; do
    [ -x "$pt/adb" ] && PATH="$pt:$PATH" && break
done

# ADB can expose the same phone simultaneously as USB, an IP:port transport,
# and an mdns service-name transport. Unqualified commands then fail with
# "more than one device/emulator". Prefer a real cable whenever one is present;
# wireless discovery remains the fallback when no USB transport exists.
if [ -z "${ANDROID_SERIAL:-}" ]; then
    usb_serial=$(adb devices -l 2>/dev/null |
        awk '$2 == "device" && / usb:/ { print $1; exit }')
    [ -z "$usb_serial" ] || export ANDROID_SERIAL=$usb_serial
fi

mdns_addr() {
    # Service instance names may contain spaces/suffixes (for example "(2)")
    # after Android rotates its wireless-debugging port. The address is always
    # the final field; positional $3 accidentally returned the service type.
    adb mdns services 2>/dev/null | awk '/_adb-tls-connect/ {print $NF; exit}'
}

ensure() {
    adb get-state >/dev/null 2>&1 && return 0
    addr=$(mdns_addr)
    [ -n "$addr" ] || { echo "phone not advertising - is Wireless debugging on?" >&2; exit 1; }
    adb connect "$addr" >/dev/null
    adb get-state >/dev/null 2>&1 || { echo "connect to $addr failed (re-pair?)" >&2; exit 1; }
}

GUEST=/data/determination

guest_running() {
    adb shell "su -c '$GUEST/lxc/bin/lxc-info -P $GUEST -n guest 2>/dev/null'" | grep -q RUNNING
}

need_guest() {
    guest_running && return 0
    echo "guest is not running - start it first (det ssh-setup boots it, or: det shell -> $GUEST/bin/guest-start)" >&2
    exit 1
}

# One layer of shell-quoting survives between here and the guest; user-supplied
# fragments must stay inside this whitelist. grep, not case: dash rejects
# literal spaces inside pattern brackets.
safe_arg() {
    [ -n "$1" ] || return 1
    printf '%s' "$1" | grep -q '[^A-Za-z0-9 .,:;@%+_/=-]' && return 1
    return 0
}

gs_user() { # gs_user <sh-cmd> - run inside container as melissa, login env
    adb shell "su -c '$GUEST/lxc/bin/lxc-attach -P $GUEST -n guest -- /usr/local/bin/det-platform run-user melissa /bin/sh -lc \"$1\"'"
}

gs_root() { # gs_root <sh-cmd> - run inside container as root
    adb shell "su -c '$GUEST/lxc/bin/lxc-attach -P $GUEST -n guest -- /bin/sh -c \"$1\"'"
}

install_guest_motd() {
    G=/data/determination
    adb push guest/setup-motd.sh /data/local/tmp/determination-setup-motd.sh >/dev/null
    if ! adb shell "su -c 'cp /data/local/tmp/determination-setup-motd.sh $G/active-guest/root/setup-motd.sh && chmod 0700 $G/active-guest/root/setup-motd.sh && $G/lxc/bin/lxc-attach -P $G -n guest -- /bin/sh /root/setup-motd.sh \"$DET_VERSION\" \"$DET_CODENAME\"'"; then
        adb shell "su -c 'rm -f /data/local/tmp/determination-setup-motd.sh'" >/dev/null
        echo 'det: guest MOTD setup failed' >&2
        return 1
    fi
    adb shell "su -c 'rm -f /data/local/tmp/determination-setup-motd.sh'" >/dev/null
}

case "${1:-status}" in
version)
    echo "Determination v$DET_VERSION \"$DET_CODENAME\" (code $DET_VERSION_CODE, $DET_RELEASE_STATUS)" ;;
find)
    addr=$(mdns_addr); [ -n "$addr" ] && echo "$addr" || { echo "not advertising" >&2; exit 1; } ;;
connect)
    ensure && adb devices | sed -n 2p ;;
shell)
    ensure; shift
    if [ $# -gt 0 ]; then
        # adb re-joins argv with spaces, so `adb shell su -c "$*"` reaches the
        # remote shell UNQUOTED: everything after the first ;/&&/| ran as the
        # shell user (the exact AGENTS.md quoting trap - this helper shipped
        # with it from day one, found 2026-07-11 masquerading as a "degraded
        # boot"). Single-quote the whole chain for the remote shell, escaping
        # embedded single quotes.
        esc=$(printf '%s' "$*" | sed "s/'/'\\\\''/g")
        adb shell "su -c '$esc'"
    else adb shell su; fi ;;
guest)
    ensure; shift
    G=/data/determination
    # Attach as the unprivileged guest user melissa (root shell: det guest-root).
    # det-platform chooses the distro's supplementary-group-safe launcher.
    # lxc-attach --uid is deliberately avoided because it drops android_input.
    # The whole su -c argument must be ONE quoted string (see AGENTS.md).
    if [ $# -gt 0 ]; then
        adb shell "su -c '$G/lxc/bin/lxc-attach -P $G -n guest -- /usr/local/bin/det-platform run-user melissa /bin/sh -lc \"$*\"'"
    else
        adb shell -t "su -c '$G/lxc/bin/lxc-attach -P $G -n guest -- /usr/local/bin/det-platform run-user melissa /bin/sh -l'"
    fi ;;
guest-root)
    ensure; shift
    G=/data/determination
    # Root shell inside the guest - admin escape hatch (was the old `det guest`).
    if [ $# -gt 0 ]; then
        adb shell "su -c '$G/lxc/bin/lxc-attach -P $G -n guest -- /bin/sh -lc \"$*\"'"
    else
        adb shell -t "su -c '$G/lxc/bin/lxc-attach -P $G -n guest -- /bin/sh -l'"
    fi ;;
passwd)
    ensure
    G=/data/determination
    # Set melissa's guest password. passwd(1) reads /dev/tty with echo off, and
    # that controlling tty does NOT survive adb->su->lxc-attach (the prompt is
    # lost and the typed password just echoes to the shell). So read it HERE,
    # where there is a real terminal, and feed chpasswd over STDIN - never argv,
    # so it stays out of ps. No -t: we want raw stdin piped through, not a pty.
    printf 'New password for guest user melissa: ' >&2
    stty -echo 2>/dev/null; read pw;  stty echo 2>/dev/null; echo >&2
    printf 'Retype new password: '                 >&2
    stty -echo 2>/dev/null; read pw2; stty echo 2>/dev/null; echo >&2
    [ -n "$pw" ]     || { echo 'det: empty password refused' >&2; exit 1; }
    [ "$pw" = "$pw2" ] || { echo 'det: passwords do not match' >&2; exit 1; }
    if printf 'melissa:%s\n' "$pw" | \
        adb shell "su -c '$G/lxc/bin/lxc-attach -P $G -n guest -- /usr/sbin/chpasswd'"
    then echo 'det: password set - sudo now works for melissa' >&2
    else echo 'det: chpasswd failed' >&2; exit 1; fi ;;
ssh-setup)
    ensure
    key_file=${2:-"$HOME/.ssh/determination_ed25519.pub"}
    case "$key_file" in *.pub) private_key=${key_file%.pub} ;; *) private_key= ;; esac
    if [ ! -r "$key_file" ]; then
        [ "$key_file" = "$HOME/.ssh/determination_ed25519.pub" ] || {
            echo "det: public key not readable: $key_file" >&2; exit 1;
        }
        command -v ssh-keygen >/dev/null || { echo 'det: ssh-keygen is not installed' >&2; exit 1; }
        mkdir -p "$HOME/.ssh"
        chmod 0700 "$HOME/.ssh"
        ssh-keygen -q -t ed25519 -N '' -C 'melissa@determination' \
            -f "$private_key"
        echo "det: generated dedicated client key: $private_key" >&2
    fi
    G=/data/determination
    # Avoid re-running guest-start for a live container. In desktop mode its
    # Android framework probes can block because system_server is deliberately
    # frozen. When a start is actually needed, detach keeper-process streams.
    if ! adb shell "su -c '$G/lxc/bin/lxc-info -P $G -n guest 2>/dev/null'" |
            grep -q RUNNING; then
        adb shell "su -c '$G/bin/guest-start </dev/null >/dev/null 2>&1'"
    fi
    install_guest_motd
    adb push guest/setup-ssh.sh /data/local/tmp/determination-setup-ssh.sh >/dev/null
    adb push "$key_file" /data/local/tmp/determination-authorized-key.pub >/dev/null
    if ! adb shell "su -c 'cp /data/local/tmp/determination-setup-ssh.sh $G/active-guest/root/setup-ssh.sh && cp /data/local/tmp/determination-authorized-key.pub $G/active-guest/root/authorized-key.pub && chmod 0700 $G/active-guest/root/setup-ssh.sh && $G/lxc/bin/lxc-attach -P $G -n guest -- /bin/sh /root/setup-ssh.sh /root/authorized-key.pub'"; then
        adb shell "su -c 'rm -f /data/local/tmp/determination-setup-ssh.sh /data/local/tmp/determination-authorized-key.pub'" >/dev/null
        echo 'det: guest SSH setup failed' >&2
        exit 1
    fi
    # A distro slot is replaceable; the phone's SSH identity is not. Capture
    # the first successfully generated host keys outside the active rootfs.
    adb shell "su -c 'SSH_ID=$G/etc/ssh-host-keys; SRC=$G/active-guest/etc/ssh; if [ ! -f \"\$SSH_ID/ssh_host_ed25519_key\" ]; then install -d -m 0700 \"\$SSH_ID\"; cp -f \"\$SRC\"/ssh_host_*_key \"\$SRC\"/ssh_host_*_key.pub \"\$SSH_ID/\"; chmod 0600 \"\$SSH_ID\"/ssh_host_*_key; chmod 0644 \"\$SSH_ID\"/ssh_host_*_key.pub; fi'" || {
        echo 'det: failed to preserve device SSH host identity' >&2
        exit 1
    }
    adb shell "su -c 'rm -f /data/local/tmp/determination-setup-ssh.sh /data/local/tmp/determination-authorized-key.pub'" >/dev/null
    # Keep host SSH policy in a drop-in. The main Include is added once without
    # replacing any unrelated user configuration.
    install -d -m 0700 "$HOME/.ssh" "$HOME/.ssh/config.d"
    printf '%s\n' \
        'Host 192.168.117.2' \
        '    User melissa' \
        '    IdentityFile ~/.ssh/determination_ed25519' \
        '    IdentitiesOnly yes' \
        > "$HOME/.ssh/config.d/determination"
    chmod 0600 "$HOME/.ssh/config.d/determination"
    if ! grep -Eq '^[[:space:]]*Include[[:space:]]+.*\.ssh/config\.d/' \
            "$HOME/.ssh/config" 2>/dev/null; then
        config_tmp=$(mktemp "$HOME/.ssh/config.XXXXXX")
        { printf 'Include ~/.ssh/config.d/*\n\n'; cat "$HOME/.ssh/config" 2>/dev/null || true; } > "$config_tmp"
        chmod 0600 "$config_tmp"
        mv "$config_tmp" "$HOME/.ssh/config"
    fi
    echo 'det: public-key SSH server ready' >&2
    "$SELF" ssh-route ;;
motd-setup)
    ensure
    G=/data/determination
    if ! adb shell "su -c '$G/lxc/bin/lxc-info -P $G -n guest 2>/dev/null'" |
            grep -q RUNNING; then
        adb shell "su -c '$G/bin/guest-start </dev/null >/dev/null 2>&1'"
    fi
    install_guest_motd ;;
ssh-route)
    ensure
    phone_ip=$(adb shell "ip -4 -brief address show wlan0" 2>/dev/null |
        awk '{ split($3, a, "/"); print a[1]; exit }' | tr -d '\r')
    [ -n "$phone_ip" ] || { echo 'det: phone has no wlan0 IPv4 address' >&2; exit 1; }
    host_dev=$(ip -4 route get "$phone_ip" 2>/dev/null |
        awk '{ for (i=1; i<=NF; i++) if ($i == "dev") { print $(i+1); exit } }')
    [ -n "$host_dev" ] || { echo "det: no host route to phone at $phone_ip" >&2; exit 1; }
    if [ "$(id -u)" -eq 0 ]; then
        ip route replace 192.168.117.0/24 via "$phone_ip" dev "$host_dev"
    elif sudo -n true 2>/dev/null; then
        sudo ip route replace 192.168.117.0/24 via "$phone_ip" dev "$host_dev"
    elif command -v pkexec >/dev/null; then
        pkexec ip route replace 192.168.117.0/24 via "$phone_ip" dev "$host_dev"
    else
        echo "det: root needed; run: sudo ip route replace 192.168.117.0/24 via $phone_ip dev $host_dev" >&2
        exit 1
    fi
    echo "det: direct route ready via $phone_ip ($host_dev)" >&2
    echo 'det: connect with: ssh melissa@192.168.117.2' >&2 ;;
ssh)
    shift
    exec ssh melissa@192.168.117.2 "$@" ;;
on)
    ensure
    # setsid-detach: the SF handoff must not die with this adb session.
    adb shell "su -c 'setsid /data/determination/bin/desktop-on >/dev/null 2>&1 &'" </dev/null
    echo "desktop-on launched (detached) - watch: det log toggle" ;;
off)
    ensure
    adb shell "su -c 'setsid /data/determination/bin/desktop-off >/dev/null 2>&1 &'" </dev/null
    echo "desktop-off launched (detached) - watch: det log toggle" ;;
linux-first)
    ensure
    action=${2:-status}
    case "$action" in
        status)
            adb shell "su -c '/data/determination/bin/boot-profile status'" ;;
        enable)
            adb shell "su -c '/data/determination/bin/boot-profile linux-first'" ;;
        disable)
            adb shell "su -c '/data/determination/bin/boot-profile phone'" ;;
        apply)
            adb shell "su -c '/data/determination/bin/boot-profile apply'" ;;
        *) echo "usage: det linux-first status|enable|disable|apply" >&2; exit 2 ;;
    esac ;;
compat)
    ensure
    action=${2:-check}
    G=/data/determination
    case "$action" in
        setup)
            if ! adb shell "su -c '$G/lxc/bin/lxc-info -P $G -n guest 2>/dev/null'" |
                    grep -q RUNNING; then
                adb shell "su -c '$G/bin/guest-start </dev/null >/dev/null 2>&1'"
            fi
            for file in det-phosh-session det-compat-check det-audio-session \
                        det-firefox-content-defaults setup-compatibility.sh \
                        det-phosh.service setup-identity.sh det-sliderd; do
                adb push "guest/$file" "/data/local/tmp/$file" >/dev/null
            done
            adb push toggle/desktop-on /data/local/tmp/determination-desktop-on >/dev/null
            adb push toggle/desktop-off /data/local/tmp/determination-desktop-off >/dev/null
            adb shell "su -c 'ROOT=\$(readlink -f $G/active-guest); \
                install -m 0755 /data/local/tmp/det-phosh-session \$ROOT/usr/local/bin/det-phosh-session; \
                install -m 0755 /data/local/tmp/det-compat-check \$ROOT/usr/local/bin/det-compat-check; \
                install -m 0755 /data/local/tmp/det-audio-session \$ROOT/usr/local/bin/det-audio-session; \
                install -m 0755 /data/local/tmp/det-firefox-content-defaults \$ROOT/usr/local/bin/det-firefox-content-defaults; \
                install -m 0755 /data/local/tmp/setup-compatibility.sh \$ROOT/usr/local/sbin/setup-compatibility.sh; \
                install -D -m 0644 /data/local/tmp/det-phosh.service \$ROOT/usr/local/lib/determination/det-phosh.service; \
                install -m 0755 /data/local/tmp/setup-identity.sh \$ROOT/usr/local/sbin/setup-identity.sh; \
                install -m 0755 /data/local/tmp/det-sliderd \$ROOT/usr/local/bin/det-sliderd; \
                install -m 0755 /data/local/tmp/determination-desktop-on $G/bin/desktop-on; \
                install -m 0755 /data/local/tmp/determination-desktop-off $G/bin/desktop-off; \
                $G/lxc/bin/lxc-attach -P $G -n guest -- /bin/sh /usr/local/sbin/setup-identity.sh \"$DET_VERSION\" \"$DET_CODENAME\"; \
                $G/lxc/bin/lxc-attach -P $G -n guest -- /bin/sh -c \"/usr/local/sbin/setup-compatibility.sh; if ! pgrep -x firefox-esr >/dev/null 2>&1; then /usr/local/bin/det-platform run-user melissa env HOME=/home/melissa USER=melissa LOGNAME=melissa /usr/local/bin/det-firefox-content-defaults; fi\"'"
            ;;
        check)
            adb shell "su -c '$G/lxc/bin/lxc-attach -P $G -n guest -- /usr/local/bin/det-compat-check --live'"
            ;;
        *) echo 'usage: det compat setup|check' >&2; exit 2 ;;
    esac ;;
distro)
    ensure
    action=${2:-status}
    G=/data/determination
    case "$action" in
        list|status)
            adb shell "su -c '$G/bin/guest-distro $action'" ;;
        select|switch)
            id=${3:-}
            case "$id" in debian|arch|alpine) ;; *) echo "usage: det distro select debian|arch|alpine" >&2; exit 2 ;; esac
            adb shell "su -c '$G/bin/guest-distro select $id'" ;;
        provision)
            adb shell "su -c '$G/bin/guest-distro provision'" ;;
        qualify)
            # Device-qualification gauntlet for guest distros (AGENTS.md:
            # arch/alpine stay "unsupported" until every gate here passes).
            id=${3:-}
            case "$id" in debian|arch|alpine) ;; *) echo "usage: det distro qualify debian|arch|alpine" >&2; exit 2 ;; esac
            pass=0; fail=0; skip=0
            gate() { # gate <name> <cmd...>  |  gate --skip <name> <reason>
                if [ "$1" = --skip ]; then
                    echo "SKIP  $2 - $3"; skip=$((skip+1)); return 0
                fi
                name=$1; shift
                if "$@" >/tmp/opencode/qualify.log 2>&1; then
                    echo "PASS  $name"; pass=$((pass+1))
                else
                    echo "FAIL  $name"; sed 's/^      | /' /tmp/opencode/qualify.log | tail -n 4 | sed 's/^/      | /'
                    fail=$((fail+1))
                fi
            }
            running=$(adb shell "su -c '$G/lxc/bin/lxc-info -P $G -n guest 2>/dev/null'" | grep -c RUNNING || true)
            [ "$running" -ge 1 ] && { echo "PASS  container-running"; pass=$((pass+1)); } ||
                { echo "FAIL  container-running (boot the guest first)"; fail=$((fail+1)); }
            running=$(adb shell "su -c '$G/lxc/bin/lxc-info -P $G -n guest 2>/dev/null'" | grep -c RUNNING || true)
            [ "$running" -ge 1 ] && { echo "PASS  container-running"; pass=$((pass+1)); } ||
                { echo "FAIL  container-running (boot the guest first)"; fail=$((fail+1)); }
            if plat=$(gs_user '/usr/local/bin/det-platform info' </dev/null | tr -d '\r'); then
                echo "PASS  det-platform info ($plat)"; pass=$((pass+1))
            else
                echo "FAIL  det-platform info (guest lacks the adapter?)"
                sed 's/^/      | /' /tmp/opencode/qualify.log 2>/dev/null | tail -n 4
                fail=$((fail+1))
            fi
            gate os-identity gs_root 'grep -q "^PRETTY_NAME=\"Determination" /etc/os-release'
            gate wl-clipboard gs_user 'command -v wl-copy >/dev/null && command -v wl-paste >/dev/null'
            gate grim-present gs_user 'command -v grim >/dev/null'
            gate input-access gs_root 'su - melissa -c "test -r /dev/input/event1"'
            gate haptics-tagged gs_root 'n=$(grep -A2 "qti-haptics" /proc/bus/input/devices | grep -o "event[0-9]*" | head -n1); [ -n "$n" ] && udevadm info -q property -n /dev/input/$n 2>/dev/null | grep -q feedbackd:rumble'
            gate pipewire-smoke gs_user 'test -x /usr/local/bin/det-pipewire-smoke && /usr/local/bin/det-pipewire-smoke'
            gate gpu-smoke gs_user 'test -x /usr/local/bin/gpu-smoke.sh && /usr/local/bin/gpu-smoke.sh'
            gate --skip restore-cycle "requires desktop-on/off + Android restore soak"
            echo
            echo "qualify($id): $pass passed, $fail failed, $skip skipped"
            [ "$fail" -eq 0 ] ;;
        install)
            id=${3:-}; archive=${4:-}
            case "$id" in arch|alpine) ;; *) echo "usage: det distro install arch|alpine ROOTFS.tar.gz" >&2; exit 2 ;; esac
            [ -r "$archive" ] || { echo "rootfs archive not readable: $archive" >&2; exit 1; }
            remote="/data/local/tmp/determination-rootfs-$id.tar.gz"
            adb push "$archive" "$remote"
            if adb shell "su -c '$G/bin/guest-distro install $id $remote'"; then
                adb shell "su -c 'rm -f $remote'" >/dev/null
            else
                echo "install failed; staged archive retained at $remote" >&2
                exit 1
            fi
            ;;
        *) echo "usage: det distro list|status|install|select|provision" >&2; exit 2 ;;
    esac ;;
log)
    ensure
    adb shell "su -c 'tail -n ${3:-60} /data/determination/log/${2:-toggle}.log'" ;;
status)
    ensure
    json=false; [ "${2:-}" = --json ] && json=true
    st_connected=$(adb devices | awk 'NR==2{print $1}')
    # One round trip; remote script always exits 0 so set -e survives a
    # missing guest-distro helper. Keys are parsed locally for text/json.
    st_remote=$(adb shell su <<'EOF'
        echo "root=`id -u`"
        echo "kernel=`uname -r`"
        if [ -e /proc/self/ns/pid ]; then echo "pidns=determination"; else echo "pidns=stock"; fi
        echo "sf=`getprop init.svc.surfaceflinger`"
        if [ -f /data/determination/run/desktop-mode ]; then echo "mode=desktop"; else echo "mode=phone"; fi
        if [ -x /data/determination/bin/boot-profile ]; then
            echo "profile=`sed -n 's/^desired=//p' /data/determination/state/boot-profile 2>/dev/null | tail -n 1`"
        else
            echo "profile-support=no"
        fi
        if [ -x /data/determination/bin/desktop-on ]; then echo "module=installed"; else echo "module=not-installed"; fi
