        echo "published to USB drive: $dest"
    else
        dest=/sdcard/Determination
        adb shell su -c "rm -rf $dest && cp -r /data/local/tmp/usb-payload $dest && rm -rf /data/local/tmp/usb-payload" </dev/null
        echo "no USB drive mounted - published to $dest instead"
    fi
    echo "next: usb-install/README.md (patch determination-boot.img in Magisk, flash install zip)" ;;
migrate)
    ensure
    adb push migrate-to-determination.sh /sdcard/Download/migrate-to-determination.sh >/dev/null
    adb shell su -c 'sh /sdcard/Download/migrate-to-determination.sh' </dev/null ;;
*)
    # Help text lives in the header comment; extract by marker, not line
    # numbers, so the two can never drift apart again.
    awk '/^#   det find/{show=1} show{print substr($0,3)} /^#                         \(run once when upgrading/{exit}' "$0"
    exit 2 ;;
esac
