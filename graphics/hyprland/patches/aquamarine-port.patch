+
+void Aquamarine::CHeadlessBackend::syncHwcOutputs() {
+    auto& hwc = Dethyprland::HwcPresenter::instance();
+    const auto previous = outputs;
+    for (auto& output : previous) {
+        if (Dethyprland::HwcPresenter::owns(output->name) &&
+            output->hwcGeneration != hwc.output(output->name).generation)
+            output->destroy();
+    }
+    for (const auto& display : hwc.outputs()) {
+        if (std::ranges::none_of(outputs, [&](const auto& output) { return output->name == display.name; }))
+            createOutput(display.name);
+    }
 }
 
