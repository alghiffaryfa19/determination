diff --git a/CMakeLists.txt b/CMakeLists.txt
index bc016d85..40ccf569 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -157,6 +157,23 @@ endif()
 
 add_executable(Hyprland ${SRCFILES} ${TRACY_CPP_FILES})
 
+find_program(DET_WAYLAND_SCANNER wayland-scanner REQUIRED)
+find_path(DET_ANDROID_INCLUDE system/window.h PATH_SUFFIXES android REQUIRED)
+find_library(DET_GRALLOC gralloc PATHS /usr/local/lib REQUIRED)
+find_library(DET_HYBRIS_COMMON hybris-common PATHS /usr/local/lib REQUIRED)
+set(DET_WLEGL_DIR "${CMAKE_CURRENT_BINARY_DIR}/android-wlegl")
+file(MAKE_DIRECTORY "${DET_WLEGL_DIR}")
+add_custom_command(
+  OUTPUT "${DET_WLEGL_DIR}/wayland-android-protocol.h" "${DET_WLEGL_DIR}/wayland-android-protocol.c"
+  COMMAND ${DET_WAYLAND_SCANNER} server-header
+    "${CMAKE_CURRENT_SOURCE_DIR}/src/dethyprland/wayland-android.xml" "${DET_WLEGL_DIR}/wayland-android-protocol.h"
+  COMMAND ${DET_WAYLAND_SCANNER} private-code
+    "${CMAKE_CURRENT_SOURCE_DIR}/src/dethyprland/wayland-android.xml" "${DET_WLEGL_DIR}/wayland-android-protocol.c"
+  DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/dethyprland/wayland-android.xml")
+target_sources(Hyprland PRIVATE "${DET_WLEGL_DIR}/wayland-android-protocol.c" "${DET_WLEGL_DIR}/wayland-android-protocol.h")
+target_include_directories(Hyprland PRIVATE "${DET_WLEGL_DIR}" "${DET_ANDROID_INCLUDE}")
+target_link_libraries(Hyprland ${DET_GRALLOC} ${DET_HYBRIS_COMMON})
+
 set(USE_GPROF ON)
 
 if(CMAKE_BUILD_TYPE MATCHES Debug OR CMAKE_BUILD_TYPE MATCHES DEBUG)
