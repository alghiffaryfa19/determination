## Aurora patch for BSD-3-Clause Aquamarine. Retain Aquamarine's
## copyright and BSD-3-Clause notice with this patch and its output.

--- a/src/backend/Backend.cpp
+++ b/src/backend/Backend.cpp
@@ -144,6 +144,10 @@
     if (hybris) {
         try {
             primaryAllocator = makeShared<AuroraHyprland::GrallocAllocator>(self.lock());
+            if (getenv("AURORA_HYBRIS_HWC") && std::string(getenv("AURORA_HYBRIS_HWC")) == "1") {
+                session = CSession::attempt(self.lock());
+                if (!session) throw std::runtime_error("libhybris input seat unavailable");
+            }
         } catch (const std::exception& error) {
             log(AQ_LOG_CRITICAL, error.what());
             return false;
--- a/src/backend/Headless.cpp
+++ b/src/backend/Headless.cpp
@@ -1,5 +1,7 @@
 #include <aquamarine/backend/Headless.hpp>
 #include "HwcPresenter.hpp"
+#include <sys/ioctl.h>
+#include <linux/input.h>
 #include <fcntl.h>
 #include <ctime>
 #include <sys/timerfd.h>
@@ -103,6 +105,9 @@
         auto& hwc = AuroraHyprland::HwcPresenter::instance();
         fds.push_back(makeShared<SPollFD>(hwc.eventFd(), [this]() {
             AuroraHyprland::HwcPresenter::instance().drain();
+            // Retry after desktop-on releases its temporary grab once the Wayland socket appears.
+            if (backend->session) for (auto& device : backend->session->sessionDevices)
+                if (device->path.starts_with("/dev/input/")) (void)ioctl(device->fd, EVIOCGRAB, 1);
             for (auto& output : outputs) if (output->name == "HWC-1" && output->frameScheduled) (*output->framecb)();
         }));
     }
